<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_mobile_application" model="ir.actions.client">
        <field name="name">Mobile Application</field>
        <field name="tag">mobile_application.action_mobile_app</field>
        <field name="path">mobile-app</field>
    </record>

    <menuitem
        id="menu_mobile_root"
        name="Mobile Application"
        action="action_mobile_application"
        web_icon="mobile_application,static/description/icon.png"
        groups="mobile_application.group_mobile_resident,mobile_application.group_mobile_staff,mobile_application.group_mobile_security"
        sequence="45"
    />

    <menuitem
        id="menu_mobile_config"
        name="Configuration"
        parent="menu_mobile_root"
        action="action_mobile_profiles"
        groups="base.group_system"
        sequence="90"
    />
</odoo>
