<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_owner_list" model="ir.ui.view">
        <field name="name">property.owner.list</field>
        <field name="model">property.owner</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="unit_id"/>
                <field name="property_id"/>
                <field name="owner_type"/>
                <field name="share_percent"/>
                <field name="effective_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_property_owner_form" model="ir.ui.view">
        <field name="name">property.owner.form</field>
        <field name="model">property.owner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="property_id"/>
                        <field name="unit_id"/>
                        <field name="owner_type"/>
                        <field name="share_percent"/>
                        <field name="effective_date"/>
                        <field name="status"/>
                        <field name="cost"/>
                        <field name="deed_ref"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_property_owner_graph" model="ir.ui.view">
        <field name="name">property.owner.graph</field>
        <field name="model">property.owner</field>
        <field name="arch" type="xml">
            <graph string="Ownership" type="bar">
                <field name="partner_id"/>
                <field name="share_percent" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_property_owner" model="ir.actions.act_window">
        <field name="name">Ownership</field>
        <field name="res_model">property.owner</field>
        <field name="view_mode">list,form,graph</field>
    </record>

    <record id="action_ownership_reports" model="ir.actions.act_window">
        <field name="name">Ownership Reports</field>
        <field name="res_model">property.owner</field>
        <field name="view_mode">graph,list</field>
        <field name="view_id" ref="view_property_owner_graph"/>
    </record>

    <record id="view_property_tenancy_list" model="ir.ui.view">
        <field name="name">property.tenancy.list</field>
        <field name="model">property.tenancy</field>
        <field name="arch" type="xml">
            <list>
                <field name="tenant_id"/>
                <field name="unit_id"/>
                <field name="property_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_property_tenancy_form" model="ir.ui.view">
        <field name="name">property.tenancy.form</field>
        <field name="model">property.tenancy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="tenant_id"/>
                        <field name="unit_id"/>
                        <field name="property_id"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_property_tenancy" model="ir.actions.act_window">
        <field name="name">Tenant History</field>
        <field name="res_model">property.tenancy</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_property_document_list" model="ir.ui.view">
        <field name="name">property.document.list</field>
        <field name="model">property.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="filename"/>
                <field name="property_id"/>
                <field name="document_type"/>
                <field name="category"/>
                <field name="status"/>
                <field name="version"/>
                <field name="expiry_date"/>
            </list>
        </field>
    </record>

    <record id="view_property_document_form" model="ir.ui.view">
        <field name="name">property.document.form</field>
        <field name="model">property.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="filename"/>
                        <field name="property_id"/>
                        <field name="building_id"/>
                        <field name="unit_id"/>
                        <field name="document_type"/>
                        <field name="category"/>
                        <field name="status"/>
                        <field name="version"/>
                        <field name="expiry_date"/>
                        <field name="attachment"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_property_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">property.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
