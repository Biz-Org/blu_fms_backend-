<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_building_list" model="ir.ui.view">
        <field name="name">property.building.list</field>
        <field name="model">property.building</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="property_id"/>
                <field name="tower_code"/>
                <field name="usage"/>
                <field name="operational_status" widget="badge"/>
                <field name="region"/>
                <field name="floor_count"/>
                <field name="unit_count"/>
                <field name="occupancy_rate" widget="progressbar"/>
            </list>
        </field>
    </record>

    <record id="view_property_building_form" model="ir.ui.view">
        <field name="name">property.building.form</field>
        <field name="model">property.building</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="property_id"/>
                        <field name="tower_code"/>
                        <field name="usage"/>
                        <field name="operational_status"/>
                        <field name="region"/>
                        <field name="floor_count"/>
                        <field name="unit_count"/>
                        <field name="occupancy_rate" widget="progressbar"/>
                    </group>
                    <notebook>
                        <page string="Floors">
                            <field name="floor_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="floor_number"/>
                                    <field name="wing"/>
                                    <field name="unit_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Units">
                            <field name="unit_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_property_building" model="ir.actions.act_window">
        <field name="name">Buildings / Towers</field>
        <field name="res_model">property.building</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_property_floor_list" model="ir.ui.view">
        <field name="name">property.floor.list</field>
        <field name="model">property.floor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="building_id"/>
                <field name="property_id"/>
                <field name="floor_number"/>
                <field name="wing"/>
                <field name="unit_count"/>
            </list>
        </field>
    </record>

    <record id="view_property_floor_form" model="ir.ui.view">
        <field name="name">property.floor.form</field>
        <field name="model">property.floor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="building_id"/>
                        <field name="property_id"/>
                        <field name="floor_number"/>
                        <field name="wing"/>
                    </group>
                    <field name="unit_ids"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_property_floor" model="ir.actions.act_window">
        <field name="name">Floors &amp; Wings</field>
        <field name="res_model">property.floor</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_property_unit_list" model="ir.ui.view">
        <field name="name">property.unit.list</field>
        <field name="model">property.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="property_id"/>
                <field name="building_id"/>
                <field name="floor_id"/>
                <field name="unit_type"/>
                <field name="area_sqft"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'occupied'"
                       decoration-danger="status == 'maintenance'"
                       decoration-info="status == 'reserved'"/>
                <field name="tenant_id"/>
            </list>
        </field>
    </record>

    <record id="view_property_unit_form" model="ir.ui.view">
        <field name="name">property.unit.form</field>
        <field name="model">property.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="property_id"/>
                            <field name="building_id"/>
                            <field name="floor_id"/>
                        </group>
                        <group>
                            <field name="unit_type"/>
                            <field name="area_sqft"/>
                            <field name="status"/>
                            <field name="tenant_id"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                    <field name="tenancy_ids">
                        <list>
                            <field name="tenant_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_property_unit_pivot" model="ir.ui.view">
        <field name="name">property.unit.pivot</field>
        <field name="model">property.unit</field>
        <field name="arch" type="xml">
            <pivot string="Occupancy Reports">
                <field name="property_id" type="row"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_property_unit_graph" model="ir.ui.view">
        <field name="name">property.unit.graph</field>
        <field name="model">property.unit</field>
        <field name="arch" type="xml">
            <graph string="Occupancy" type="pie">
                <field name="status"/>
            </graph>
        </field>
    </record>

    <record id="action_property_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">property.unit</field>
        <field name="view_mode">list,form,graph</field>
    </record>

    <record id="action_property_occupancy" model="ir.actions.act_window">
        <field name="name">Occupancy</field>
        <field name="res_model">property.unit</field>
        <field name="view_mode">graph,list</field>
        <field name="view_id" ref="view_property_unit_graph"/>
    </record>

    <record id="action_unit_status" model="ir.actions.act_window">
        <field name="name">Unit Status</field>
        <field name="res_model">property.unit</field>
        <field name="view_mode">list,graph</field>
        <field name="context">{'group_by': 'status'}</field>
    </record>

    <record id="action_occupancy_reports" model="ir.actions.act_window">
        <field name="name">Occupancy Reports</field>
        <field name="res_model">property.unit</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>
</odoo>
