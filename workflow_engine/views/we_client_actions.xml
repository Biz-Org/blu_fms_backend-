<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      One OWL client action implementation: tag workflow_engine_app.
      Seven menu routes share that tag with different params.screen values.
    -->
    <record id="action_we_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">workflow_engine_app</field>
        <field name="target">current</field>
        <field name="context">{'we_screen': 'dashboard'}</field>
        <field name="params" eval="{'screen': 'dashboard'}"/>
    </record>

    <record id="action_we_builder" model="ir.actions.client">
        <field name="name">Workflow Builder</field>
        <field name="tag">workflow_engine_app</field>
