<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_we_execution" model="ir.sequence">
        <field name="name">Workflow Execution</field>
        <field name="code">workflow.engine.execution</field>
        <field name="prefix">WE</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_cron_we_process_escalations" model="ir.cron">
        <field name="name">WE: Process Escalations</field>
        <field name="model_id" ref="model_workflow_engine_escalation_rule"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_escalations()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
