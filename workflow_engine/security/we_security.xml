<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_workflow_engine" model="ir.module.category">
        <field name="name">Workflow Engine</field>
        <field name="sequence">51</field>
    </record>

    <record id="group_we_user" model="res.groups">
        <field name="name">Workflow Engine User</field>
        <field name="category_id" ref="module_category_workflow_engine"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_we_manager" model="res.groups">
        <field name="name">Workflow Engine Manager</field>
        <field name="category_id" ref="module_category_workflow_engine"/>
        <field name="implied_ids" eval="[(4, ref('group_we_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_we_admin" model="res.groups">
        <field name="name">Workflow Engine Administrator</field>
        <field name="category_id" ref="module_category_workflow_engine"/>
        <field name="implied_ids" eval="[(4, ref('group_we_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
