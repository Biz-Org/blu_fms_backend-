<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_community_communication" model="ir.module.category">
        <field name="name">Community and Communication</field>
        <field name="description">Community engagement and communication for facility management</field>
        <field name="sequence">58</field>
        <field name="parent_id" ref="base.module_category_services"/>
    </record>

    <!-- Portal (not Internal User). Same OWL Community webclient via a restricted entry. -->
    <record id="group_community_resident" model="res.groups">
        <field name="name">Resident</field>
        <field name="comment">Community residents use the shared Community &amp; Communication app with view and participation rights. They are not Internal Users.</field>
        <field name="share" eval="True"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_portal')])]"/>
    </record>

    <record id="group_community_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="comment">Property management staff who create and publish community communications.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_community_communication"/>
    </record>

    <record id="group_community_moderator" model="res.groups">
        <field name="name">Moderator</field>
        <field name="comment">Moderators can lock, pin, and remove discussions and review reported content.</field>
        <field name="implied_ids" eval="[(4, ref('group_community_officer'))]"/>
        <field name="category_id" ref="module_category_community_communication"/>
    </record>

    <record id="group_community_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Full configuration of Community &amp; Communication, including placeholder master data.</field>
        <field name="implied_ids" eval="[(4, ref('group_community_moderator'))]"/>
        <field name="category_id" ref="module_category_community_communication"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
