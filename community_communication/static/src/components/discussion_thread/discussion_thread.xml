<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="community_communication.DiscussionThread">
        <div class="o_cc_shell" t-if="state.payload">
            <div class="o_cc_card mb-3">
                <div class="d-flex gap-2 mb-2">
                    <span class="o_cc_pill" t-esc="state.payload.category"/>
                    <span class="o_cc_pill success" t-esc="state.payload.state"/>
                </div>
                <h2 class="h4" t-esc="state.payload.title"/>
                <div class="small text-muted mb-2">
                    <t t-esc="state.payload.author"/> · <t t-esc="state.payload.view_count"/> views ·
                    <t t-esc="state.payload.comment_count"/> comments
                </div>
                <div t-out="body(state.payload.body)"/>
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.react('support')">
                        Support <t t-esc="state.payload.support_count"/>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.react('oppose')">
                        <t t-esc="state.payload.oppose_count"/>
                    </button>
                    <button t-if="!state.payload.is_followed" class="btn o_cc_btn_primary btn-sm" t-on-click="follow">Follow Discussion</button>
                    <button t-else="" class="btn btn-outline-primary btn-sm" t-on-click="unfollow">Following</button>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-lg-8">
                    <div class="o_cc_card">
                        <div class="fw-bold mb-2">Comments &amp; Replies · <t t-esc="state.payload.comment_count"/> total</div>
                        <textarea class="form-control mb-2" placeholder="Write a reply..." t-model="state.reply"/>
                        <button class="btn o_cc_btn_primary btn-sm mb-3" t-on-click="postReply">Post Reply</button>
                        <t t-foreach="state.payload.comments" t-as="comment" t-key="comment.id">
                            <div class="o_cc_thread_comment" t-att-style="comment.parent_id ? 'margin-left:24px' : ''">
                                <div class="fw-semibold">
                                    <t t-esc="comment.author"/>
                                    <span t-if="comment.is_admin" class="o_cc_pill ms-1">Admin</span>
                                </div>
                                <div class="small text-muted" t-esc="comment.date"/>
                                <div t-out="body(comment.body)"/>
                            </div>
                        </t>
                    </div>
                </div>
                <div class="col-lg-4" t-if="state.payload.can_moderate">
                    <div class="o_cc_card">
                        <div class="fw-bold mb-2">Management Actions</div>
                        <button class="btn btn-link d-block text-start" t-on-click="() => this.moderate('action_pin')">Pin Discussion</button>
                        <button class="btn btn-link d-block text-start" t-on-click="() => this.moderate('action_lock')">Lock Discussion</button>
                        <button class="btn btn-link d-block text-start text-danger" t-on-click="() => this.moderate('action_remove')">Remove Content</button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
