<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cc_community_list" model="ir.ui.view">
        <field name="name">community.communication.community.list</field>
        <field name="model">community.communication.community</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_cc_community_form" model="ir.ui.view">
        <field name="name">community.communication.community.form</field>
        <field name="model">community.communication.community</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cc_community" model="ir.actions.act_window">
        <field name="name">Communities</field>
        <field name="res_model">community.communication.community</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_cc_building_list" model="ir.ui.view">
        <field name="name">community.communication.building.list</field>
        <field name="model">community.communication.building</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="community_id"/>
            </list>
        </field>
    </record>
    <record id="view_cc_building_form" model="ir.ui.view">
        <field name="name">community.communication.building.form</field>
        <field name="model">community.communication.building</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="community_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cc_building" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">community.communication.building</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_cc_unit_list" model="ir.ui.view">
        <field name="name">community.communication.unit.list</field>
        <field name="model">community.communication.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="building_id"/>
                <field name="community_id"/>
            </list>
        </field>
    </record>
    <record id="view_cc_unit_form" model="ir.ui.view">
        <field name="name">community.communication.unit.form</field>
        <field name="model">community.communication.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="building_id"/>
                        <field name="community_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cc_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">community.communication.unit</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_cc_venue_list" model="ir.ui.view">
        <field name="name">community.communication.venue.list</field>
        <field name="model">community.communication.venue</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="community_id"/>
                <field name="address"/>
            </list>
        </field>
    </record>
    <record id="view_cc_venue_form" model="ir.ui.view">
        <field name="name">community.communication.venue.form</field>
        <field name="model">community.communication.venue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="community_id"/>
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cc_venue" model="ir.actions.act_window">
        <field name="name">Venues</field>
        <field name="res_model">community.communication.venue</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_cc_resident_list" model="ir.ui.view">
        <field name="name">community.communication.resident.list</field>
        <field name="model">community.communication.resident</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="community_id"/>
                <field name="unit_id"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="view_cc_resident_form" model="ir.ui.view">
        <field name="name">community.communication.resident.form</field>
        <field name="model">community.communication.resident</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="user_id"/>
                        <field name="community_id"/>
                        <field name="unit_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cc_resident" model="ir.actions.act_window">
        <field name="name">Residents</field>
        <field name="res_model">community.communication.resident</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
