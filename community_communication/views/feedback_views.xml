<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cc_feedback_search" model="ir.ui.view">
        <field name="name">community.communication.feedback.search</field>
        <field name="model">community.communication.feedback</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Resolved" name="resolved" domain="[('state', '=', 'resolved')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
            </search>
        </field>
    </record>
    <record id="view_cc_feedback_list" model="ir.ui.view">
        <field name="name">community.communication.feedback.list</field>
        <field name="model">community.communication.feedback</field>
        <field name="arch" type="xml">
            <list class="o_cc_shell">
                <field name="name"/>
                <field name="subject"/>
                <field name="category"/>
                <field name="resident_id"/>
                <field name="create_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_cc_feedback_form" model="ir.ui.view">
        <field name="name">community.communication.feedback.form</field>
        <field name="model">community.communication.feedback</field>
        <field name="arch" type="xml">
            <form class="o_cc_shell">
                <header>
                    <button name="action_in_progress" string="Start Progress" type="object" invisible="state != 'submitted'"/>
                    <button name="action_resolve" string="Resolve" type="object" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_close" string="Close" type="object" invisible="state not in ('submitted', 'in_progress', 'resolved')"/>
                    <button name="action_reopen" string="Reopen" type="object" invisible="state != 'resolved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="subject"/>
                            <field name="category"/>
                            <field name="priority"/>
                            <field name="community_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="anonymous"/>
                            <field name="resident_id" invisible="anonymous"/>
                            <field name="assignee_id"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                    <notebook>
                        <page string="Responses">
                            <field name="response_ids">
                                <list editable="bottom">
                                    <field name="author_id"/>
                                    <field name="body"/>
                                </list>
                            </field>
                        </page>
                        <page string="Internal Notes" groups="community_communication.group_community_officer">
                            <field name="note_ids">
                                <list editable="bottom">
                                    <field name="author_id"/>
                                    <field name="body"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_cc_feedback" model="ir.actions.act_window">
        <field name="name">Resident Feedback</field>
        <field name="res_model">community.communication.feedback</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
