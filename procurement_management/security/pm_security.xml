<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_procurement_management" model="ir.module.category">
        <field name="name">Procurement Management</field>
        <field name="sequence">70</field>
    </record>

    <record id="group_procurement_user" model="res.groups">
        <field name="name">Procurement User</field>
        <field name="category_id" ref="module_category_procurement_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_procurement_officer" model="res.groups">
        <field name="name">Procurement Officer</field>
        <field name="category_id" ref="module_category_procurement_management"/>
        <field name="implied_ids" eval="[(4, ref('group_procurement_user'))]"/>
    </record>

    <record id="group_procurement_manager" model="res.groups">
        <field name="name">Procurement Manager</field>
        <field name="category_id" ref="module_category_procurement_management"/>
        <field name="implied_ids" eval="[(4, ref('group_procurement_officer'))]"/>
    </record>

    <record id="group_procurement_admin" model="res.groups">
        <field name="name">Procurement Administrator</field>
        <field name="category_id" ref="module_category_procurement_management"/>
        <field name="implied_ids" eval="[(4, ref('group_procurement_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
