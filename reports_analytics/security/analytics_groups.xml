<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_reports_analytics" model="ir.module.category">
        <field name="name">Reports and Analytics</field>
        <field name="description">Reports &amp; Analytics roles for FMS. Independent groups; not auto-assigned to Odoo administrators.</field>
        <field name="sequence">62</field>
        <field name="parent_id" ref="base.module_category_services"/>
    </record>

    <record id="group_analytics_management" model="res.groups">
        <field name="name">Management</field>
        <field name="comment">Executive visibility: read reports, KPIs, dashboards, execution history, and audit logs across authorized FMS data.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_reports_analytics"/>
    </record>
    <record id="group_analytics_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="comment">Configure analytics data sources, report definitions, KPIs, dashboards, and review audit history. Does not imply other FMS module admin roles.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_reports_analytics"/>
        <!-- Same bootstrap pattern as Integration &amp; IoT / Community: default login admin can open the app. -->
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_analytics_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Operational analytics ownership: maintain report and KPI definitions, run reports, and manage dashboards within assigned scope.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_reports_analytics"/>
    </record>
</odoo>
