# PostgreSQL (docker-compose)
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Odoo database connection
HOST=db
PORT=5432
USER=odoo
PASSWORD=odoo

# First database to create/use (optional; set when initializing)
ODOO_DB=fms

# Odoo master password (admin_passwd in odoo.conf) — change in production
ODOO_ADMIN_PASSWORD=changeme

# AI Copilot (optional; configure in Odoo UI or ir.config_parameter)
# GEMINI_API_KEY=
