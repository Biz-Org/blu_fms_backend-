<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_document_management" model="ir.module.category">
        <field name="name">Document Management</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_dm_user" model="res.groups">
        <field name="name">Document Management User</field>
        <field name="category_id" ref="module_category_document_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_dm_manager" model="res.groups">
        <field name="name">Document Management Manager</field>
        <field name="category_id" ref="module_category_document_management"/>
        <field name="implied_ids" eval="[(4, ref('group_dm_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_dm_admin" model="res.groups">
        <field name="name">Document Management Administrator</field>
        <field name="category_id" ref="module_category_document_management"/>
        <field name="implied_ids" eval="[(4, ref('group_dm_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
