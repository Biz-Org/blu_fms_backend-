<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_utility_run" model="ir.actions.report">
        <field name="name">Utility Report</field>
        <field name="model">utility.management.report.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">utility_management.report_utility_run</field>
        <field name="report_file">utility_management.report_utility_run</field>
        <field name="print_report_name">'Utility Report - %s' % (object.name)</field>
    </record>

    <template id="report_utility_run">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 t-out="doc.definition_id.name"/>
                        <p t-out="doc.name"/>
                        <t t-foreach="doc.report_text()" t-as="line">
                            <p t-out="line"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
