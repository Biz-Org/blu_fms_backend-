<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_utility_management" model="ir.module.category">
        <field name="name">Utility Management</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_utility_staff" model="res.groups">
        <field name="name">Utility Staff</field>
        <field name="category_id" ref="module_category_utility_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_facility_manager" model="res.groups">
        <field name="name">Facility Manager</field>
        <field name="category_id" ref="module_category_utility_management"/>
        <field name="implied_ids" eval="[(4, ref('group_utility_staff'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
