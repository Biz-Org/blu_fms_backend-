<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_apartment_message_list" model="ir.ui.view">
        <field name="name">apartment.message.list</field>
        <field name="model">apartment.message</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="thread"/>
                <field name="subject"/>
                <field name="author"/>
                <field name="unit_id"/>
                <field name="unread"/>
            </list>
        </field>
    </record>

    <record id="view_apartment_message_form" model="ir.ui.view">
        <field name="name">apartment.message.form</field>
        <field name="model">apartment.message</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="thread"/>
                            <field name="subject"/>
                            <field name="tag"/>
                            <field name="author"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="unit_id"/>
                            <field name="tenant_id"/>
                            <field name="date"/>
                            <field name="mine"/>
                            <field name="unread"/>
                            <field name="attachment"/>
                        </group>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_apartment_message" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">apartment.message</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_apartment_document_list" model="ir.ui.view">
        <field name="name">apartment.document.list</field>
        <field name="model">apartment.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="category"/>
                <field name="status"/>
                <field name="date"/>
                <field name="uploaded_by"/>
            </list>
        </field>
    </record>

    <record id="view_apartment_document_form" model="ir.ui.view">
        <field name="name">apartment.document.form</field>
        <field name="model">apartment.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="unit_id"/>
                            <field name="property_id"/>
                            <field name="category"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="version"/>
                            <field name="kind"/>
                            <field name="tags"/>
                            <field name="uploaded_by"/>
                            <field name="file_name" invisible="1"/>
                            <field name="file" filename="file_name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_apartment_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">apartment.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_apartment_notice_list" model="ir.ui.view">
        <field name="name">apartment.notice.list</field>
        <field name="model">apartment.notice</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="title"/>
                <field name="category"/>
                <field name="unit_id"/>
                <field name="unread"/>
                <field name="archived"/>
            </list>
        </field>
    </record>

    <record id="view_apartment_notice_form" model="ir.ui.view">
        <field name="name">apartment.notice.form</field>
        <field name="model">apartment.notice</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="title"/>
                        <field name="category"/>
                        <field name="unit_id"/>
                        <field name="tenant_id"/>
                        <field name="date"/>
                        <field name="unread"/>
                        <field name="archived"/>
                        <field name="body"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_apartment_notice" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">apartment.notice</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
