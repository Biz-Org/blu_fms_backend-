<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_apartment_payment_list" model="ir.ui.view">
        <field name="name">apartment.payment.list</field>
        <field name="model">apartment.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="payment_type"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="reference"/>
            </list>
        </field>
    </record>

    <record id="view_apartment_payment_form" model="ir.ui.view">
        <field name="name">apartment.payment.form</field>
        <field name="model">apartment.payment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="due,pending,paid,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="unit_id"/>
                            <field name="property_id"/>
                            <field name="tenant_id"/>
                            <field name="tenancy_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="date"/>
                            <field name="payment_type"/>
                            <field name="method"/>
                            <field name="reference"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_apartment_payment_search" model="ir.ui.view">
        <field name="name">apartment.payment.search</field>
        <field name="model">apartment.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="reference"/>
                <filter name="due" string="Due" domain="[('state', '=', 'due')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <group>
                    <filter name="group_unit" string="Unit" context="{'group_by': 'unit_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_apartment_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">apartment.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
