<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_iot_heartbeat" model="ir.cron">
        <field name="name">IoT: device heartbeat and offline detection</field>
        <field name="model_id" ref="model_integration_iot_device"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_heartbeats()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="ir_cron_iot_stale_sensors" model="ir.cron">
        <field name="name">IoT: detect unavailable sensor data</field>
        <field name="model_id" ref="model_integration_iot_reading"/>
        <field name="state">code</field>
        <field name="code">model._cron_detect_stale()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="ir_cron_iot_schedules" model="ir.cron">
        <field name="name">IoT: run lighting and HVAC schedules</field>
        <field name="model_id" ref="model_integration_iot_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_schedules()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
