<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="partner_iot_manager" model="res.partner">
            <field name="name">IoT Manager</field>
            <field name="email">iot_manager@example.com</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        <record id="user_iot_manager" model="res.users" context="{'no_reset_password': True}">
            <field name="partner_id" ref="partner_iot_manager"/>
            <field name="login">iot_manager</field>
            <field name="password">iot_manager</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[Command.link(ref('base.main_company'))]"/>
            <field name="groups_id" eval="[Command.set([ref('base.group_user'), ref('group_integration_admin')])]"/>
            <field name="action_id" ref="action_iot_dashboard_ui"/>
        </record>
    </data>
</odoo>
