<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_integration_iot" model="ir.module.category">
        <field name="name">Integration and IoT</field>
        <field name="description">Integration &amp; IoT Management roles. Independent from Community, Fire &amp; Safety, and Compliance groups. FUTURE: central RBAC (#27) maps users to these groups.</field>
        <field name="sequence">61</field>
        <field name="parent_id" ref="base.module_category_services"/>
    </record>

    <record id="privilege_integration_admin" model="res.groups.privilege">
        <field name="name">Integration Admin</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_integration_iot"/>
        <field name="placeholder">No access</field>
    </record>

    <record id="group_integration_admin" model="res.groups">
        <field name="name">Integration Admin</field>
        <field name="sequence">10</field>
        <field name="comment">Primary role: configure IoT/BMS integrations, manage devices and sensors, control connected systems, manage automation, and review alerts. Does not imply Community, Fire &amp; Safety, or Compliance manager roles.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="privilege_integration_admin"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
