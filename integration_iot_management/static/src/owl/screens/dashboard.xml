<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="integration_iot_management.Dashboard">
        <div class="o_action o_iot_app">
            <IotAppShell active="'dashboard'">
                <div class="o_iot_shell">
                    <div class="o_iot_page_header">
                        <div>
                            <h1>IoT &amp; BMS Dashboard</h1>
                            <p>Monitor connected systems, alerts, automation, and energy from Odoo records.</p>
                        </div>
                    </div>
                    <div t-if="state.loading" class="o_iot_empty"><h3>Loading dashboard</h3><p>Fetching IoT records.</p></div>
                    <div t-elif="state.error" class="o_iot_empty o_iot_error">
                        <h3>Dashboard could not load</h3>
                        <p t-esc="state.error"/>
                        <button class="o_iot_btn primary" t-on-click="reload">Retry</button>
                    </div>
                    <t t-else="">
                        <div class="o_iot_kpi_row">
                            <IotKpiCard label="'Connected Devices'" value="kpis.connected_devices || 0" icon="'fa-wifi'" hint="(kpis.online_devices || 0) + ' online'" onClick.bind="openDevices"/>
                            <IotKpiCard label="'Offline Devices'" value="kpis.offline_devices || 0" icon="'fa-plug'" tone="kpis.offline_devices ? 'danger' : ''" onClick.bind="openDevices"/>
                            <IotKpiCard label="'Active Alerts'" value="kpis.active_alerts || 0" icon="'fa-bell'" tone="kpis.active_alerts ? 'warning' : ''"/>
                            <IotKpiCard label="'Automation Rules'" value="kpis.automation_rules || 0" icon="'fa-cogs'" onClick.bind="openAutomation"/>
                            <IotKpiCard label="'Energy Usage'" value="kpis.energy_usage || 0" icon="'fa-bolt'" hint="'Latest kWh reading'" onClick.bind="openEnergy"/>
                        </div>
                        <div class="o_iot_dash_grid">
                            <div class="o_iot_card">
                                <div class="o_iot_card_head">System Status</div>
                                <div class="o_iot_status_row" t-on-click="() => this.openSystems('lighting')"><span><span t-attf-class="o_iot_dot {{ data.systems.lighting and data.systems.lighting.state }}"/>Lighting</span><IotStatusBadge state="data.systems.lighting and data.systems.lighting.state" label="data.systems.lighting and data.systems.lighting.label"/></div>
                                <div class="o_iot_status_row" t-on-click="() => this.openSystems('hvac')"><span><span t-attf-class="o_iot_dot {{ data.systems.hvac and data.systems.hvac.state }}"/>HVAC</span><IotStatusBadge state="data.systems.hvac and data.systems.hvac.state" label="data.systems.hvac and data.systems.hvac.label"/></div>
                                <div class="o_iot_status_row" t-on-click="() => this.openSystems('fire')"><span><span t-attf-class="o_iot_dot {{ data.systems.fire_alarm and data.systems.fire_alarm.state }}"/>Fire Alarm</span><IotStatusBadge state="data.systems.fire_alarm and data.systems.fire_alarm.state" label="data.systems.fire_alarm and data.systems.fire_alarm.label"/></div>
                                <div class="o_iot_status_row" t-on-click="() => this.openSystems('environment')"><span><span t-attf-class="o_iot_dot {{ data.systems.environment and data.systems.environment.state }}"/>Environment</span><IotStatusBadge state="data.systems.environment and data.systems.environment.state" label="data.systems.environment and data.systems.environment.label"/></div>
                                <div class="o_iot_status_row"><span><span t-attf-class="o_iot_dot {{ data.systems.bms and data.systems.bms.state }}"/>BMS Core</span><IotStatusBadge state="data.systems.bms and data.systems.bms.state" label="data.systems.bms and data.systems.bms.label"/></div>
                            </div>
                            <div class="o_iot_card">
                                <div class="o_iot_card_head">Environment</div>
                                <div class="o_iot_status_row"><span>Temperature</span><strong t-esc="envValue('temperature')"/></div>
                                <div class="o_iot_status_row"><span>Humidity</span><strong t-esc="envValue('humidity')"/></div>
                                <div class="o_iot_status_row"><span>Air Quality</span><strong t-esc="envValue('air_quality')"/></div>
                            </div>
                            <div class="o_iot_card">
                                <div class="o_iot_card_head o_iot_card_head_row"><span>Energy Consumption</span><button class="o_iot_link" t-on-click="openEnergy">Open Energy</button></div>
                                <div class="o_iot_kpi_hint">Current draw: <t t-esc="data.energy.current || 0"/> kWh</div>
                                <div class="o_iot_bars mt-3">
                                    <div t-foreach="data.energy.trend" t-as="row" t-key="row.t" class="o_iot_bar fill" t-att-style="'height:' + barHeight(row.kwh)"/>
                                </div>
                                <IotEmptyState t-if="!(data.energy.trend and data.energy.trend.length)" title="'No energy readings yet'" hint="'Meter readings will plot here.'"/>
                            </div>
                            <div class="o_iot_card">
                                <div class="o_iot_card_head">Attention Required</div>
                                <t t-foreach="data.attention" t-as="item" t-key="item.id">
                                    <div class="o_iot_attention_row">
                                        <div>
                                            <div class="fw-semibold" t-esc="item.title"/>
                                            <div class="small text-muted"><t t-esc="item.location"/> · <t t-esc="formatWhen(item.time)"/></div>
                                        </div>
                                        <IotStatusBadge state="item.priority"/>
                                    </div>
                                </t>
                                <IotEmptyState t-if="!data.attention.length" title="'Nothing needs attention'" hint="'Offline devices, faults, and threshold alerts appear here.'"/>
                            </div>
                        </div>
                        <div class="o_iot_card mt-3">
                            <div class="o_iot_card_head">Recent Activity</div>
                            <t t-foreach="data.activity" t-as="row" t-key="row.id">
                                <div class="o_iot_status_row">
                                    <span t-esc="row.title"/>
                                    <span>
                                        <span t-if="row.simulated" class="o_iot_sim">Simulated</span>
                                        <span class="small text-muted" t-esc="formatWhen(row.time)"/>
                                    </span>
                                </div>
                            </t>
                            <IotEmptyState t-if="!data.activity.length" title="'No activity yet'" hint="'Device, automation, and alarm events will appear here.'"/>
                        </div>
                    </t>
                </div>
            </IotAppShell>
        </div>
    </t>
</templates>
