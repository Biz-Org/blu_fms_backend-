<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fire_safety" model="ir.module.category">
        <field name="name">Fire and Safety</field>
        <field name="description">Fire &amp; Safety Management roles. Parallel FMS catalogue roles, not a privilege ladder. FUTURE / NOT IMPLEMENTED: central RBAC (#27) maps users to these groups.</field>
        <field name="sequence">59</field>
        <field name="parent_id" ref="base.module_category_services"/>
    </record>

    <!-- Independent roles: these groups do not imply each other, so Odoo 18 shows them as checkboxes. -->

    <record id="group_fire_safety_manager" model="res.groups">
        <field name="name">Safety Manager</field>
        <field name="comment">Inspect, report, correct, verify, close, manage equipment, drills, checklists, procedures, contacts, and activate emergencies.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_fire_safety"/>
    </record>
    <record id="group_fire_safety_security" model="res.groups">
        <field name="name">Security</field>
        <field name="comment">Report incidents, view inspections, view and respond to emergencies. Cannot verify or close other users' corrective actions.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_fire_safety"/>
    </record>
    <record id="group_fire_safety_guard" model="res.groups">
        <field name="name">Security Guard</field>
        <field name="comment">Create and read own incidents. View procedures and emergency contacts. No equipment master management.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_fire_safety"/>
    </record>
    <record id="group_fire_safety_facility" model="res.groups">
        <field name="name">Facility Manager</field>
        <field name="comment">Operational visibility: dashboards, reports, and Fire &amp; Safety records. Property-scope is FUTURE / NOT IMPLEMENTED until Property Management (#2) and RBAC (#27).</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_fire_safety"/>
    </record>
    <record id="group_fire_safety_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="comment">Read-only inspections, evidence, logs, and reports.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_fire_safety"/>
    </record>
    <record id="group_fire_safety_executive" model="res.groups">
        <field name="name">Management / CXO</field>
        <field name="comment">Dashboards, KPIs, trends, and exports.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_fire_safety"/>
    </record>
</odoo>
