<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fs_inspection_search" model="ir.ui.view">
        <field name="name">fire.safety.inspection.search</field>
        <field name="model">fire.safety.inspection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="property_id"/>
                <field name="assigned_user_id"/>
                <filter string="Scheduled" name="scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Fire Inspection" name="fire_inspection" domain="[('inspection_type', '=', 'fire_inspection')]"/>
                <filter string="Safety Audit" name="safety_audit" domain="[('inspection_type', '=', 'safety_audit')]"/>
                <group>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'inspection_type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_fs_inspection_list" model="ir.ui.view">
        <field name="name">fire.safety.inspection.list</field>
        <field name="model">fire.safety.inspection</field>
        <field name="arch" type="xml">
            <list class="o_fs_app">
                <field name="name"/>
                <field name="inspection_type"/>
                <field name="scheduled_date"/>
                <field name="property_id"/>
                <field name="assigned_user_id"/>
                <field name="is_overdue" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_fs_inspection_form" model="ir.ui.view">
        <field name="name">fire.safety.inspection.form</field>
        <field name="model">fire.safety.inspection</field>
        <field name="arch" type="xml">
            <form class="o_fs_app">
                <header>
                    <button name="action_start_inspection" type="object" string="Start" class="btn-primary" invisible="state != 'scheduled'"/>
                    <button name="action_complete_inspection" type="object" string="Complete" class="btn-primary" invisible="state != 'in_progress'" groups="fire_safety_management.group_fire_safety_manager"/>
                    <button name="action_mark_completed" type="object" string="Mark Completed" invisible="state != 'pending'" groups="fire_safety_management.group_fire_safety_manager"/>
                    <button name="action_close_inspection" type="object" string="Close" invisible="state != 'completed'" groups="fire_safety_management.group_fire_safety_manager"/>
                    <button name="action_apply_checklist_template" type="object" string="Apply Checklist" invisible="state not in ('scheduled', 'in_progress')" groups="fire_safety_management.group_fire_safety_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,in_progress,pending,completed,closed"/>
                </header>
                <sheet>
                    <group>
                        <field name="line_count"/>
                        <field name="finding_count"/>
                        <field name="failed_line_count"/>
                        <field name="action_count"/>
                    </group>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="inspection_type"/>
                            <field name="scheduled_date"/>
                            <field name="checklist_template_id"/>
                            <field name="inspector_id"/>
                            <field name="assigned_user_id"/>
                            <field name="is_overdue"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="property_id"/>
                            <field name="building_id"/>
                            <field name="area_id"/>
                            <field name="site_id" readonly="1"/>
                            <field name="department_id"/>
                            <field name="location_detail"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="required"/>
                                    <field name="result"/>
                                    <field name="notes"/>
                                    <field name="attachment_ids" widget="many2many_binary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Findings">
                            <field name="finding_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="severity"/>
                                    <field name="state"/>
                                    <field name="action_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Evidence">
                            <field name="attachment_ids" widget="many2many_binary"/>
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_fs_inspection" model="ir.actions.act_window">
        <field name="name">Inspections &amp; Audits</field>
        <field name="res_model">fire.safety.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_scheduled': 1}</field>
    </record>
</odoo>
