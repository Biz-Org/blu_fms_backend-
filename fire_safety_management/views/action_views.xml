<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fs_action_search" model="ir.ui.view">
        <field name="name">fire.safety.action.search</field>
        <field name="model">fire.safety.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="finding_id"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Awaiting Verification" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue', '=', True)]"/>
            </search>
        </field>
    </record>
    <record id="view_fs_action_list" model="ir.ui.view">
        <field name="name">fire.safety.action.list</field>
        <field name="model">fire.safety.action</field>
        <field name="arch" type="xml">
            <list class="o_fs_app">
                <field name="name"/>
                <field name="finding_id"/>
                <field name="assigned_user_id"/>
                <field name="deadline"/>
                <field name="is_overdue"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_fs_action_form" model="ir.ui.view">
        <field name="name">fire.safety.action.form</field>
        <field name="model">fire.safety.action</field>
        <field name="arch" type="xml">
            <form class="o_fs_app">
                <header>
                    <button name="action_mark_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_verify" type="object" string="Verify" invisible="state != 'done'" groups="fire_safety_management.group_fire_safety_manager"/>
                    <button name="action_close" type="object" string="Close" class="btn-primary" invisible="state != 'done'" groups="fire_safety_management.group_fire_safety_manager"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state != 'done'" groups="fire_safety_management.group_fire_safety_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,done,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="finding_id"/>
                            <field name="inspection_id"/>
                            <field name="incident_id"/>
                            <field name="deadline"/>
                            <field name="is_overdue"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="property_id"/>
                            <field name="building_id"/>
                            <field name="area_id"/>
                            <field name="verified_by_id"/>
                            <field name="verified_datetime"/>
                            <field name="closed_by_id"/>
                            <field name="closed_datetime"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <group>
                        <field name="verification_notes"/>
                        <field name="evidence_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_fs_action" model="ir.actions.act_window">
        <field name="name">Corrective Actions</field>
        <field name="res_model">fire.safety.action</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
