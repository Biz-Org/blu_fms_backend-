<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fs_finding_list" model="ir.ui.view">
        <field name="name">fire.safety.finding.list</field>
        <field name="model">fire.safety.finding</field>
        <field name="arch" type="xml">
            <list class="o_fs_app">
                <field name="name"/>
                <field name="inspection_id"/>
                <field name="incident_id" optional="hide"/>
                <field name="severity"/>
                <field name="action_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_fs_finding_form" model="ir.ui.view">
        <field name="name">fire.safety.finding.form</field>
        <field name="model">fire.safety.finding</field>
        <field name="arch" type="xml">
            <form class="o_fs_app">
                <header>
                    <button name="action_mark_in_progress" type="object" string="Start Corrective Work" class="btn-primary" invisible="state != 'open'" groups="fire_safety_management.group_fire_safety_manager"/>
                    <button name="action_close_finding" type="object" string="Close Finding" invisible="state == 'closed'" groups="fire_safety_management.group_fire_safety_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="severity"/>
                            <field name="inspection_id"/>
                            <field name="line_id"/>
                            <field name="incident_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="property_id"/>
                            <field name="building_id"/>
                            <field name="area_id"/>
                            <field name="assigned_user_id"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <notebook>
                        <page string="Corrective Actions">
                            <field name="action_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="assigned_user_id"/>
                                    <field name="deadline"/>
                                    <field name="state"/>
                                    <field name="is_overdue"/>
                                </list>
                            </field>
                        </page>
                        <page string="Evidence">
                            <field name="evidence_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_fs_finding" model="ir.actions.act_window">
        <field name="name">Findings</field>
        <field name="res_model">fire.safety.finding</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
