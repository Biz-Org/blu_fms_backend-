<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_drill_notify" model="mail.template">
        <field name="name">Fire &amp; Safety: Mock Drill Notification</field>
        <field name="model_id" ref="model_fire_safety_drill"/>
        <field name="subject">Mock drill: {{ object.name }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="description">Notifies mock-drill participants using Odoo mail.</field>
        <field name="body_html" type="html">
<div style="margin:0;padding:0;font-size:14px;color:#1f1633;">
    <p>A Fire &amp; Safety mock drill has been scheduled.</p>
    <p style="font-size:18px;font-weight:700;color:#6d28d9;"><t t-out="object.name"/></p>
    <p>Type: <t t-out="object.drill_type"/> · When: <t t-out="object.scheduled_datetime"/> · Conducted by: <t t-out="object.conducted_by"/></p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="mail_template_emergency_activate" model="mail.template">
        <field name="name">Fire &amp; Safety: Emergency Activated</field>
        <field name="model_id" ref="model_fire_safety_emergency"/>
        <field name="subject">Emergency activated: {{ object.name }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="description">Posted when an emergency is activated.</field>
        <field name="body_html" type="html">
<div style="margin:0;padding:0;font-size:14px;color:#1f1633;">
    <p style="font-size:18px;font-weight:700;color:#b91c1c;">Emergency activated</p>
    <p><t t-out="object.name"/> · <t t-out="object.emergency_type"/> · <t t-out="object.severity"/></p>
    <p t-if="object.location_detail">Location: <t t-out="object.location_detail"/></p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
