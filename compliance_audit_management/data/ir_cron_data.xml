<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_document_expiry" model="ir.cron">
        <field name="name">Compliance: refresh document expiry states</field>
        <field name="model_id" ref="model_compliance_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_document_states()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="ir_cron_compliance_alerts" model="ir.cron">
        <field name="name">Compliance: generate alerts and reminder activities</field>
        <field name="model_id" ref="model_compliance_alert"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
