<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_compliance_audit" model="ir.module.category">
        <field name="name">Compliance and Audit</field>
        <field name="description">Compliance &amp; Audit Management roles (FMS module #24). FUTURE: central RBAC (#27) maps users to these groups.</field>
        <field name="sequence">60</field>
        <field name="parent_id" ref="base.module_category_services"/>
    </record>

    <!-- Exactly two primary FMS roles for module #24 (independently assignable). -->

    <record id="group_compliance_manager" model="res.groups">
        <field name="name">Compliance Manager</field>
        <field name="comment">Primary role: plan, evidence, audit, correct, verify, and close compliance records. Configure requirements and checklist templates.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_compliance_audit"/>
        <field name="users" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>
    <record id="group_compliance_auditor" model="res.groups">
        <field name="name">Compliance Auditor</field>
        <field name="comment">Primary role: read-only access to compliance records, audit evidence, logs, and reports. No create/write/unlink and no workflow actions.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_compliance_audit"/>
    </record>
</odoo>
