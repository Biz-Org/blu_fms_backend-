        <field name="tag">compliance_audit_management.action_dashboard</field>
        <field name="path">ca-dashboard</field>
    </record>
    <record id="action_ca_activities_ui" model="ir.actions.client">
        <field name="name">Compliance Activities</field>
        <field name="tag">compliance_audit_management.action_activities</field>
        <field name="path">ca-activities</field>
    </record>
    <record id="action_ca_documents_ui" model="ir.actions.client">
        <field name="name">Compliance Documents</field>
        <field name="tag">compliance_audit_management.action_documents</field>
        <field name="path">ca-documents</field>
    </record>
    <record id="action_ca_calendar_ui" model="ir.actions.client">
        <field name="name">Compliance Calendar</field>
        <field name="tag">compliance_audit_management.action_calendar</field>
        <field name="path">ca-calendar</field>
    </record>
    <record id="action_ca_audits_ui" model="ir.actions.client">
        <field name="name">Audits &amp; Inspections</field>
        <field name="tag">compliance_audit_management.action_audits</field>
