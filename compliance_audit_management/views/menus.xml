    <record id="action_ca_nc_ui" model="ir.actions.client">
        <field name="name">Non-Compliance</field>
        <field name="tag">compliance_audit_management.action_non_compliance</field>
        <field name="path">ca-non-compliance</field>
    </record>
    <record id="action_ca_regulatory_ui" model="ir.actions.client">
        <field name="name">Regulatory Reporting</field>
        <field name="tag">compliance_audit_management.action_regulatory</field>
        <field name="path">ca-regulatory</field>
    </record>
    <record id="action_ca_reports_ui" model="ir.actions.client">
        <field name="name">Compliance Reports</field>
        <field name="tag">compliance_audit_management.action_reports</field>
        <field name="path">ca-reports</field>
    </record>

    <menuitem
        id="menu_compliance_root"
        name="Compliance &amp; Audit"
        web_icon="compliance_audit_management,static/description/icon.png"
        action="action_ca_dashboard_ui"
        groups="compliance_audit_management.group_compliance_manager,compliance_audit_management.group_compliance_auditor"
        sequence="52"
    />

    <menuitem id="menu_ca_dashboard" name="Dashboard" parent="menu_compliance_root" action="action_ca_dashboard_ui" sequence="1"/>
    <menuitem id="menu_ca_activities_ui" name="Compliance Activities" parent="menu_compliance_root" action="action_ca_activities_ui" sequence="10"/>
    <menuitem id="menu_ca_documents_ui" name="Compliance Documents" parent="menu_compliance_root" action="action_ca_documents_ui" sequence="20"/>
    <menuitem id="menu_ca_calendar_ui" name="Compliance Calendar" parent="menu_compliance_root" action="action_ca_calendar_ui" sequence="25"/>
    <menuitem id="menu_ca_audits_ui" name="Audits &amp; Inspections" parent="menu_compliance_root" action="action_ca_audits_ui" sequence="30"/>
    <menuitem id="menu_ca_nc_ui" name="Non-Compliance" parent="menu_compliance_root" action="action_ca_nc_ui" sequence="40"/>
    <menuitem id="menu_ca_regulatory_ui" name="Regulatory Reporting" parent="menu_compliance_root" action="action_ca_regulatory_ui" sequence="50"/>
    <menuitem id="menu_ca_reports_ui" name="Compliance Reports" parent="menu_compliance_root" action="action_ca_reports_ui" sequence="60"/>

