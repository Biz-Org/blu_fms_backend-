    <menuitem id="menu_ca_area" name="Areas" parent="menu_ca_config" action="action_ca_area" sequence="50"/>
    <menuitem id="menu_ca_check_native" name="Activities (native)" parent="menu_ca_config" action="action_ca_check" sequence="60"/>
    <menuitem id="menu_ca_document_native" name="Documents (native)" parent="menu_ca_config" action="action_ca_document" sequence="70"/>
    <menuitem id="menu_ca_audit_native" name="Audits (native)" parent="menu_ca_config" action="action_ca_audit" sequence="80"/>
    <menuitem id="menu_ca_finding_native" name="Findings (native)" parent="menu_ca_config" action="action_ca_finding" sequence="90"/>
