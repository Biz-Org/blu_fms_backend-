<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ca_nc_list" model="ir.ui.view">
        <field name="name">compliance.non.compliance.list</field>
        <field name="model">compliance.non.compliance</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="source"/>
                <field name="severity"/>
                <field name="assigned_user_id"/>
                <field name="due_date"/>
                <field name="is_overdue"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_ca_nc_form" model="ir.ui.view">
        <field name="name">compliance.non.compliance.form</field>
        <field name="model">compliance.non.compliance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_assign" type="object" string="Assign" invisible="state != 'open'"/>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state not in ('open', 'assigned')"/>
                    <button name="action_submit_verification" type="object" string="Submit for Verification" invisible="state != 'in_progress'"/>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state != 'pending_verification'"/>
                    <button name="action_close" type="object" string="Close" invisible="state != 'resolved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="reference" readonly="1"/>
                        <field name="source"/>
                        <field name="severity"/>
                        <field name="requirement_id"/>
                        <field name="finding_id"/>
                        <field name="check_id"/>
                        <field name="audit_id"/>
                        <field name="property_id"/>
                        <field name="building_id"/>
                        <field name="area_id"/>
                        <field name="assigned_user_id"/>
                        <field name="due_date"/>
                        <field name="company_id"/>
                        <field name="is_overdue"/>
                        <field name="action_count"/>
                    </group>
                    <field name="description"/>
                    <field name="root_cause"/>
                    <field name="internal_notes"/>
                    <field name="action_ids">
                        <list>
                            <field name="name"/>
                            <field name="assigned_user_id"/>
                            <field name="deadline"/>
                            <field name="state"/>
                        </list>
                    </field>
                    <field name="evidence_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_ca_non_compliance" model="ir.actions.act_window">
        <field name="name">Non-Compliance</field>
        <field name="res_model">compliance.non.compliance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
