<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ca_property_list" model="ir.ui.view">
        <field name="name">compliance.property.list</field>
        <field name="model">compliance.property</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="code"/><field name="company_id"/><field name="active"/></list>
        </field>
    </record>
    <record id="view_ca_property_form" model="ir.ui.view">
        <field name="name">compliance.property.form</field>
        <field name="model">compliance.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <field name="note"/>
                    <field name="building_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ca_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">compliance.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_ca_building_list" model="ir.ui.view">
        <field name="name">compliance.building.list</field>
        <field name="model">compliance.building</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="property_id"/><field name="code"/><field name="active"/></list>
        </field>
    </record>
    <record id="view_ca_building_form" model="ir.ui.view">
        <field name="name">compliance.building.form</field>
        <field name="model">compliance.building</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="property_id"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <field name="area_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="area_kind"/>
                            <field name="active"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ca_building" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">compliance.building</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_ca_area_list" model="ir.ui.view">
        <field name="name">compliance.area.list</field>
        <field name="model">compliance.area</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="building_id"/><field name="area_kind"/><field name="active"/></list>
        </field>
    </record>
    <record id="action_ca_area" model="ir.actions.act_window">
        <field name="name">Areas</field>
        <field name="res_model">compliance.area</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
