<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ca_alert_list" model="ir.ui.view">
        <field name="name">compliance.alert.list</field>
        <field name="model">compliance.alert</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="alert_type"/>
                <field name="priority"/>
                <field name="due_date"/>
                <field name="assigned_user_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_ca_alert_form" model="ir.ui.view">
        <field name="name">compliance.alert.form</field>
        <field name="model">compliance.alert</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_acknowledge" type="object" string="Acknowledge" invisible="state != 'open'"/>
                    <button name="action_escalate" type="object" string="Escalate" invisible="state in ('escalated', 'closed')"/>
                    <button name="action_close" type="object" string="Close" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="alert_type"/>
                        <field name="priority"/>
                        <field name="due_date"/>
                        <field name="assigned_user_id"/>
                        <field name="company_id"/>
                        <field name="res_model"/>
                        <field name="res_id"/>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_ca_alert" model="ir.actions.act_window">
        <field name="name">Compliance Alerts</field>
        <field name="res_model">compliance.alert</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
