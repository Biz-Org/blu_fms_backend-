<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="maintenance.TeamKanbanView" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <xpath expr="//button[hasclass('o-kanban-button-new')]" position="replace">
            <button type="button"
                    class="btn btn-primary o-kanban-button-new o_pm_create_team_btn"
                    accesskey="c"
                    t-on-click="() => this.createRecord()"
                    data-bounce-button="">
                <t t-esc="createTeamLabel"/>
            </button>
        </xpath>
    </t>

</templates>
