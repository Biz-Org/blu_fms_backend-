        <record id="request_example_truck_not_starting" model="maintenance.request">
            <field name="name">Truck not starting - starter / electrical</field>
            <field name="equipment_id" ref="equipment_vehicle_01_truck"/>
            <field name="maintenance_team_id" ref="maintenance_team_workflow_examples"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="owner_user_id" ref="base.user_admin"/>
            <field name="maintenance_type">corrective</field>
            <field name="planning_maintenance_type">breakdown</field>
            <field name="work_order_sequence">WO-DEMO-TRK-01</field>
            <field name="work_area">Bay A</field>
            <field name="priority">3</field>
            <field name="impact_level">high</field>
            <field name="affected_department">Transport</field>
            <field name="request_date" eval="(DateTime.today() - relativedelta(days=8)).strftime('%Y-%m-%d')"/>
            <field name="close_date" eval="(DateTime.today() - relativedelta(days=5)).strftime('%Y-%m-%d')"/>
            <field name="planned_date" eval="(DateTime.today() - relativedelta(days=7)).strftime('%Y-%m-%d')"/>
            <field name="schedule_date" eval="DateTime.now() - relativedelta(days=7)"/>
            <field name="planned_hours">4</field>
            <field name="planned_duration">4</field>
            <field name="actual_hours">5.5</field>
            <field name="duration">5.5</field>
            <field name="stage_id" ref="stage_3"/>
            <field name="kanban_state">done</field>
            <field name="execution_status">completed</field>
            <field name="go_no_go_decision">go</field>
            <field name="decision_resolution_notes">Vehicle cleared for linehaul after starter service and charging system verification.</field>
            <field name="execution_notes">Replaced starter solenoid; cleaned battery terminals; load-tested alternator output.</field>
            <field name="mechanic_required" eval="True"/>
            <field name="electrician_required" eval="True"/>
            <field name="mechanical_cost">320</field>
            <field name="electrical_cost">185</field>
            <field name="vibration_level">critical_high</field>
            <field name="bearing_temp_state">high</field>
            <field name="failure_risk_percent">82</field>
            <field name="rca_method">five_why</field>
            <field name="final_root_cause">Corroded battery terminals causing voltage drop and starter failure</field>
            <field name="fishbone_summary">Man: missed terminal inspection on PM. Machine: high vibration at alternator. Method: no torque spec on clamps. Material: corroded terminals. Environment: road salt exposure.</field>
            <field name="fault_tree_summary">No-crank AND low voltage AND high resistance at terminals â†’ starter inrush insufficient.</field>
            <field name="mom_discussion">Morning shift no-crank. Manual vibration reading at alternator pulley flagged critical.</field>
            <field name="mom_decision">Replace starter components; add terminal inspection to monthly PM.</field>
            <field name="mom_action_owner">Plant Maintenance Lead</field>
            <field name="instruction_type">text</field>
            <field name="instruction_text"><![CDATA[<p>Lock-out starter circuit. Verify battery voltage &gt; 12.4V before crank test.</p>]]></field>
        </record>

