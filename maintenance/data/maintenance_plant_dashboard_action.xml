<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="maintenance_plant_app_action" model="ir.actions.client">
            <field name="name">Maintenance Dashboard</field>
            <field name="tag">maintenance_plant_app</field>
            <field name="target">current</field>
            <field name="params" eval="{'screen': 'dashboard'}"/>
        </record>

        <!-- Dashboard uses plant app content; top nav stays standard Odoo menus -->
        <record id="menu_m_dashboard" model="ir.ui.menu">
            <field name="name">Dashboard</field>
            <field name="action" ref="maintenance_plant_app_action"/>
            <field name="sequence">10</field>
        </record>

        <record id="menu_m_dashboard_teams" model="ir.ui.menu">
            <field name="name">Maintenance Teams</field>
            <field name="action" ref="maintenance_dashboard_action"/>
            <field name="sequence">20</field>
        </record>

        <!-- Equipment menu action is set in maintenance_equipment_overview_action.xml -->
        <record id="menu_equipment_form" model="ir.ui.menu">
            <field name="name">Equipment</field>
            <field name="sequence">20</field>
        </record>
        <record id="menu_m_operations" model="ir.ui.menu">
            <field name="name">Operations</field>
            <field name="sequence">30</field>
        </record>
        <record id="menu_m_planning_root" model="ir.ui.menu">
            <field name="name">Planning</field>
            <field name="sequence">40</field>
        </record>
        <record id="menu_m_analysis_root" model="ir.ui.menu">
            <field name="name">Analysis</field>
            <field name="sequence">50</field>
        </record>
        <record id="menu_m_reports" model="ir.ui.menu">
            <field name="name">Reporting</field>
            <field name="sequence">60</field>
        </record>
        <record id="menu_maintenance_configuration" model="ir.ui.menu">
            <field name="name">Configuration</field>
            <field name="sequence">70</field>
        </record>

        <function model="maintenance.rul.tobm.dashboard" name="apply_plant_navbar_menu_order"/>
    </data>
</odoo>
