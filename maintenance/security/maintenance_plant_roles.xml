<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Plant maintenance role hierarchy: Operator → Supervisor → Manager -->
    <record id="group_plant_maintenance_operator" model="res.groups">
        <field name="name">Plant Maintenance Operator</field>
        <field name="category_id" ref="base.module_category_manufacturing_maintenance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Create and execute work orders; read equipment in the plant.</field>
    </record>

    <record id="group_plant_maintenance_supervisor" model="res.groups">
        <field name="name">Plant Maintenance Supervisor</field>
        <field name="category_id" ref="base.module_category_manufacturing_maintenance"/>
        <field name="implied_ids" eval="[(4, ref('group_plant_maintenance_operator'))]"/>
        <field name="comment">Plan work, import equipment Excel files, and oversee team work orders.</field>
    </record>

    <record id="group_equipment_manager" model="res.groups">
        <field name="name">Plant Maintenance Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_plant_maintenance_supervisor'))]"/>
        <field name="comment">Full plant maintenance administration: equipment master, uploads, teams, and configuration.</field>
    </record>

    <data noupdate="1">

        <!-- Operators: own / assigned requests (inherits standard user rule) -->
        <record id="equipment_request_rule_plant_operator" model="ir.rule">
            <field name="name">Plant operators: own and assigned maintenance requests</field>
            <field name="model_id" ref="model_maintenance_request"/>
            <field name="domain_force">['|', '|', ('owner_user_id', '=', user.id), ('user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_plant_maintenance_operator'))]"/>
        </record>

        <!-- Supervisors: all requests in their company -->
        <record id="equipment_request_rule_plant_supervisor" model="ir.rule">
            <field name="name">Plant supervisors: company maintenance requests</field>
            <field name="model_id" ref="model_maintenance_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
            <field name="groups" eval="[(4, ref('group_plant_maintenance_supervisor'))]"/>
        </record>

        <!-- Operators & supervisors: read all company equipment -->
        <record id="equipment_rule_plant_read" model="ir.rule">
            <field name="name">Plant roles: read company equipment</field>
            <field name="model_id" ref="model_maintenance_equipment"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
            <field name="groups" eval="[(4, ref('group_plant_maintenance_operator')), (4, ref('group_plant_maintenance_supervisor'))]"/>
        </record>

    </data>

</odoo>
