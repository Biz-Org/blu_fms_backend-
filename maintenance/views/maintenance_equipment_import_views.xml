<?xml version="1.0" encoding="utf-8"?>

<odoo>



    <record id="maintenance_equipment_import_wizard_form" model="ir.ui.view">

        <field name="name">maintenance.equipment.import.wizard.form</field>

        <field name="model">maintenance.equipment.import.wizard</field>

        <field name="arch" type="xml">

            <form string="Import Excel">

                <sheet>

                    <group>
                        <field name="filename" invisible="1"/>
                        <field name="file" filename="filename"/>
                    </group>
                    <field name="result_message" nolabel="1" readonly="1" invisible="not result_message"/>
                    <p class="text-muted" invisible="result_message">
                        Upload Excel → equipment appears here.
                        Delete the upload under <strong>Uploaded Excel</strong> → equipment disappears.
                    </p>

                </sheet>

                <footer>

                    <button string="Import" name="action_import_excel" type="object" class="btn-primary"/>

                    <button string="Download template" name="action_download_template" type="object" class="btn-secondary"/>

                    <button string="Uploaded Excel" name="action_open_uploads" type="object" class="btn-secondary"/>

                    <button string="Close" special="cancel" class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>



    <record id="action_maintenance_equipment_import_wizard" model="ir.actions.act_window">

        <field name="name">Import Excel</field>

        <field name="res_model">maintenance.equipment.import.wizard</field>

        <field name="view_mode">form</field>

        <field name="target">new</field>

        <field name="groups_id" eval="[(4, ref('maintenance.group_plant_maintenance_supervisor'))]"/>

        <field name="binding_model_id" ref="maintenance.model_maintenance_equipment"/>

        <field name="binding_view_types">list,kanban</field>

    </record>



    <record id="action_maintenance_equipment_excel_template_download" model="ir.actions.server">

        <field name="name">Download template</field>

        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>

        <field name="state">code</field>

        <field name="code">

wizard = env['maintenance.equipment.import.wizard'].create({})

action = wizard.action_download_template()

        </field>

    </record>



    <record id="action_maintenance_equipment_import_log" model="ir.actions.act_window">
        <field name="name">Uploaded Excel</field>
        <field name="res_model">maintenance.equipment.import.log</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('maintenance.group_plant_maintenance_supervisor'))]"/>
    </record>

    <!-- Do not reset Equipment menu to old kanban — overview client action owns the menu. -->

    <record id="hr_equipment_view_kanban_import_buttons" model="ir.ui.view">

        <field name="name">equipment.kanban.import.buttons</field>

        <field name="model">maintenance.equipment</field>

        <field name="inherit_id" ref="maintenance.hr_equipment_view_kanban"/>

        <field name="arch" type="xml">

            <xpath expr="//kanban" position="inside">

                <header>

                    <button string="Import Excel" type="action" name="%(maintenance.action_maintenance_equipment_import_wizard)d" display="always" groups="maintenance.group_plant_maintenance_supervisor"/>

                    <button string="Uploaded Excel" type="action" name="%(maintenance.action_maintenance_equipment_import_log)d" display="always" groups="maintenance.group_plant_maintenance_supervisor"/>

                </header>

            </xpath>

        </field>

    </record>



    <record id="hr_equipment_view_tree_import_buttons" model="ir.ui.view">

        <field name="name">equipment.list.import.buttons</field>

        <field name="model">maintenance.equipment</field>

        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>

        <field name="arch" type="xml">

            <xpath expr="//list" position="inside">

                <header>

                    <button string="Import Excel" type="action" name="%(maintenance.action_maintenance_equipment_import_wizard)d" display="always" groups="maintenance.group_plant_maintenance_supervisor"/>

                    <button string="Uploaded Excel" type="action" name="%(maintenance.action_maintenance_equipment_import_log)d" display="always" groups="maintenance.group_plant_maintenance_supervisor"/>

                </header>

            </xpath>

        </field>

    </record>



    <record id="maintenance_equipment_import_log_tree" model="ir.ui.view">

        <field name="name">maintenance.equipment.import.log.list</field>

        <field name="model">maintenance.equipment.import.log</field>

        <field name="arch" type="xml">

            <list string="Uploaded Excel" create="false" edit="false" delete="true">

                <field name="upload_date"/>

                <field name="filename"/>

                <field name="equipment_count"/>

                <field name="imported_count"/>

                <field name="user_id"/>

                <field name="state" widget="badge"

                       decoration-success="state == 'success'"

                       decoration-warning="state == 'partial'"

                       decoration-danger="state == 'failed'"/>

            </list>

        </field>

    </record>



    <record id="maintenance_equipment_import_log_form" model="ir.ui.view">

        <field name="name">maintenance.equipment.import.log.form</field>

        <field name="model">maintenance.equipment.import.log</field>

        <field name="arch" type="xml">

            <form string="Uploaded Excel" create="false" edit="false">

                <header>

                    <button string="Remove upload &amp; equipment" name="action_remove_upload" type="object"

                            class="btn-primary" confirm="All equipment from this Excel upload will be removed. Continue?"/>

                    <button string="Download Excel file" name="action_download_file" type="object" class="btn-secondary"/>

                    <button string="Download error report" name="action_download_error_report" type="object"

                            class="btn-secondary" invisible="not error_report"/>

                </header>

                <sheet>

                    <group>

                        <group>

                            <field name="filename"/>

                            <field name="upload_date"/>

                            <field name="user_id"/>

                            <field name="equipment_count"/>

                            <field name="state" widget="badge"/>

                        </group>

                        <group>

                            <field name="total_records"/>

                            <field name="imported_count"/>

                            <field name="skipped_count"/>

                            <field name="failed_count"/>

                        </group>

                    </group>

                    <field name="summary_message" nolabel="1" readonly="1"/>

                    <field name="equipment_ids" readonly="1">

                        <list create="false" edit="false" delete="false">

                            <field name="name"/>

                            <field name="equipment_code"/>

                            <field name="serial_no"/>

                            <field name="location"/>

                        </list>

                    </field>

                    <field name="source_file" invisible="1"/>

                    <field name="source_filename" invisible="1"/>

                    <field name="error_report" invisible="1"/>

                    <field name="error_report_filename" invisible="1"/>

                </sheet>

            </form>

        </field>

    </record>



    <record id="hr_equipment_view_search_excel_filter" model="ir.ui.view">
        <field name="name">equipment.search.excel.filter</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my']" position="before">
                <filter string="From Excel" name="from_excel" domain="[('excel_import_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="hr_equipment_view_tree_excel_source" model="ir.ui.view">
        <field name="name">equipment.list.excel.source</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="excel_import_id" string="Excel upload" optional="show"/>
            </xpath>
        </field>
    </record>

    <function model="maintenance.equipment" name="_deactivate_equipment_import_menu"/>
    <function model="maintenance.equipment" name="restore_equipment_after_excel_revert"/>



</odoo>

