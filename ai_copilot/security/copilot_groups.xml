<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ai_copilot" model="ir.module.category">
        <field name="name">AI Copilot</field>
        <field name="description">Access to the facility management AI Copilot. Independent of other FMS roles.</field>
        <field name="sequence">64</field>
        <field name="parent_id" ref="base.module_category_services"/>
    </record>

    <record id="group_copilot_user" model="res.groups">
        <field name="name">Authorized User</field>
        <field name="comment">Ask AI Copilot questions about FMS records and knowledge documents this user is already allowed to read.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_ai_copilot"/>
    </record>
    <record id="group_copilot_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Configure the AI provider, knowledge documents, and who can use AI Copilot. Does not grant access to other FMS modules.</field>
        <field name="implied_ids" eval="[(4, ref('ai_copilot.group_copilot_user'))]"/>
        <field name="category_id" ref="module_category_ai_copilot"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
