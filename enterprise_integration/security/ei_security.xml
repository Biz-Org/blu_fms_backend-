<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_enterprise_integration" model="ir.module.category">
        <field name="name">Enterprise Integration</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_ei_user" model="res.groups">
        <field name="name">Enterprise Integration User</field>
        <field name="category_id" ref="module_category_enterprise_integration"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ei_manager" model="res.groups">
        <field name="name">Enterprise Integration Manager</field>
        <field name="category_id" ref="module_category_enterprise_integration"/>
        <field name="implied_ids" eval="[(4, ref('group_ei_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_ei_admin" model="res.groups">
        <field name="name">Enterprise Integration Administrator</field>
        <field name="category_id" ref="module_category_enterprise_integration"/>
        <field name="implied_ids" eval="[(4, ref('group_ei_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
