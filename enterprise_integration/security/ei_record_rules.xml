<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company rules for User+ (inherited by Manager/Admin) -->
    <record id="ei_rule_integration_company_user" model="ir.rule">
        <field name="name">EI Integration multi-company</field>
        <field name="model_id" ref="model_ei_integration"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ei_user'))]"/>
    </record>

