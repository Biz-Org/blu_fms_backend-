<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_pm_generate_schedules" model="ir.cron">
        <field name="name">PM: Generate schedules from active plans</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_plan"/>
        <field name="state">code</field>
        <field name="code">model.cron_generate_schedules()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_pm_expire_plans" model="ir.cron">
        <field name="name">PM: Expire ended plans</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_plan"/>
        <field name="state">code</field>
        <field name="code">model.cron_expire_plans()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_pm_schedule_states" model="ir.cron">
        <field name="name">PM: Update schedule due/overdue states</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_schedule"/>
        <field name="state">code</field>
        <field name="code">model.cron_update_schedule_states()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_pm_work_order_overdue" model="ir.cron">
        <field name="name">PM: Flag overdue work orders</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_work_order"/>
        <field name="state">code</field>
        <field name="code">model.cron_update_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
