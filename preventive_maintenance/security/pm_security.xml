<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_preventive_maintenance" model="ir.module.category">
        <field name="name">Preventive Maintenance</field>
        <field name="description">Roles for preventive maintenance management</field>
        <field name="sequence">55</field>
    </record>

    <record id="group_pm_maintenance_manager" model="res.groups">
        <field name="name">PM Maintenance Manager</field>
        <field name="category_id" ref="module_category_preventive_maintenance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_pm_technician" model="res.groups">
        <field name="name">PM Technician</field>
        <field name="category_id" ref="module_category_preventive_maintenance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_pm_admin" model="res.groups">
        <field name="name">PM Administrator</field>
        <field name="category_id" ref="module_category_preventive_maintenance"/>
        <field name="comment">Full PM access including user management. Implies Manager and Technician.</field>
        <field name="implied_ids" eval="[(4, ref('group_pm_maintenance_manager')), (4, ref('group_pm_technician'))]"/>
    </record>

    <!-- Record rules -->
    <record id="pm_rule_plan_company_manager" model="ir.rule">
        <field name="name">PM Plan — company (Manager)</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_plan"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pm_maintenance_manager'))]"/>
    </record>

    <record id="pm_rule_plan_company_technician" model="ir.rule">
        <field name="name">PM Plan — company read (Technician)</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_plan"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pm_technician'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="pm_rule_schedule_company_manager" model="ir.rule">
        <field name="name">PM Schedule — company (Manager)</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_schedule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pm_maintenance_manager'))]"/>
    </record>

    <record id="pm_rule_schedule_tech_assigned" model="ir.rule">
        <field name="name">PM Schedule — assigned WO (Technician)</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_schedule"/>
        <field name="domain_force">[
            ('company_id', 'in', company_ids),
            '|', ('work_order_id.user_id', '=', False),
            ('work_order_id.user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('group_pm_technician'))]"/>
    </record>

    <record id="pm_rule_wo_manager" model="ir.rule">
        <field name="name">PM Work Order — company (Manager)</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_work_order"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pm_maintenance_manager'))]"/>
    </record>

    <record id="pm_rule_wo_technician" model="ir.rule">
        <field name="name">PM Work Order — assigned (Technician)</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_work_order"/>
        <field name="domain_force">[
            ('company_id', 'in', company_ids),
            '|', ('user_id', '=', False), ('user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('group_pm_technician'))]"/>
    </record>

    <record id="pm_rule_material_tech" model="ir.rule">
        <field name="name">PM Material Line — assigned WO</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_material_line"/>
        <field name="domain_force">[
            '|', ('work_order_id.user_id', '=', False),
            ('work_order_id.user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('group_pm_technician'))]"/>
    </record>

    <record id="pm_rule_cost_tech" model="ir.rule">
        <field name="name">PM Cost Line — assigned WO</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_cost_line"/>
        <field name="domain_force">[
            '|', ('work_order_id.user_id', '=', False),
            ('work_order_id.user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('group_pm_technician'))]"/>
    </record>

    <record id="pm_rule_checklist_result_tech" model="ir.rule">
        <field name="name">PM Checklist Result — assigned WO</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_checklist_result"/>
        <field name="domain_force">[
            '|', ('work_order_id.user_id', '=', False),
            ('work_order_id.user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('group_pm_technician'))]"/>
    </record>

    <record id="pm_rule_inspection_tech" model="ir.rule">
        <field name="name">PM Inspection — assigned WO (Technician read)</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_inspection"/>
        <field name="domain_force">[
            '|', ('work_order_id.user_id', '=', False),
            ('work_order_id.user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('group_pm_technician'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="pm_rule_audit_manager" model="ir.rule">
        <field name="name">PM Audit — managers only domain</field>
        <field name="model_id" ref="preventive_maintenance.model_pm_audit_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pm_maintenance_manager'))]"/>
    </record>
</odoo>
