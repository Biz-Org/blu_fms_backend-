<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_command_center" model="ir.module.category">
        <field name="name">Command Center</field>
        <field name="sequence">53</field>
    </record>

    <record id="group_cc_user" model="res.groups">
        <field name="name">Command Center User</field>
        <field name="category_id" ref="module_category_command_center"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_cc_manager" model="res.groups">
        <field name="name">Command Center Manager</field>
        <field name="category_id" ref="module_category_command_center"/>
        <field name="implied_ids" eval="[(4, ref('group_cc_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_cc_admin" model="res.groups">
        <field name="name">Command Center Administrator</field>
        <field name="category_id" ref="module_category_command_center"/>
        <field name="implied_ids" eval="[(4, ref('group_cc_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
