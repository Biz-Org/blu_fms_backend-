    <record id="seq_cc_incident" model="ir.sequence">
        <field name="name">Command Center Incident</field>
        <field name="code">cc.incident</field>
        <field name="prefix">CC-INC</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
