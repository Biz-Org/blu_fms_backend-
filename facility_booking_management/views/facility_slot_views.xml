<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_facility_slot_config_tree" model="ir.ui.view">
        <field name="name">facility.slot.config.tree</field>
        <field name="model">facility.slot.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="facility_id"/>
                <field name="opening_time" widget="float_time"/>
                <field name="closing_time" widget="float_time"/>
                <field name="slot_duration"/>
                <field name="buffer_time"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_facility_slot_config_form" model="ir.ui.view">
        <field name="name">facility.slot.config.form</field>
        <field name="model">facility.slot.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="facility_id"/>
                        <field name="active"/>
                        <field name="opening_time" widget="float_time"/>
                        <field name="closing_time" widget="float_time"/>
                        <field name="slot_duration"/>
                        <field name="buffer_time"/>
                    </group>
                    <group>
                        <field name="break_start" widget="float_time"/>
                        <field name="break_end" widget="float_time"/>
                        <field name="working_day_ids" widget="many2many_tags"/>
                    </group>
                    <field name="holiday_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="date"/>
                            <field name="active"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_facility_slot_config" model="ir.actions.act_window">
        <field name="name">Time Slot Configurations</field>
        <field name="res_model">facility.slot.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
