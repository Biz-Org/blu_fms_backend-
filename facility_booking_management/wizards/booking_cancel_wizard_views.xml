<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_booking_cancel_wizard_form" model="ir.ui.view">
        <field name="name">facility.booking.cancel.wizard.form</field>
        <field name="model">facility.booking.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Booking">
                <group>
                    <field name="booking_id" readonly="1"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm_cancel" type="object" string="Confirm Cancel" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
