<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_booking_reject_wizard_form" model="ir.ui.view">
        <field name="name">facility.booking.reject.wizard.form</field>
        <field name="model">facility.booking.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Booking">
                <group>
                    <field name="booking_id" readonly="1"/>
                    <field name="comment"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
