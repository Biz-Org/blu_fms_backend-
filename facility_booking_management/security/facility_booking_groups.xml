<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_facility_booking" model="ir.module.category">
        <field name="name">Facility Booking</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_facility_resident" model="res.groups">
        <field name="name">Resident</field>
        <field name="category_id" ref="module_category_facility_booking"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_facility_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="category_id" ref="module_category_facility_booking"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_facility_manager" model="res.groups">
        <field name="name">Community Manager</field>
        <field name="category_id" ref="module_category_facility_booking"/>
        <field name="implied_ids" eval="[(4, ref('group_facility_approver'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
