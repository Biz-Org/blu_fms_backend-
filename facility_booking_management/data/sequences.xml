<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_facility_facility" model="ir.sequence">
        <field name="name">Facility</field>
        <field name="code">facility.facility</field>
        <field name="prefix">FAC/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_facility_booking" model="ir.sequence">
        <field name="name">Facility Booking</field>
        <field name="code">facility.booking</field>
        <field name="prefix">BK/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
