<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_booking_reminders" model="ir.cron">
        <field name="name">Facility Booking: Send Reminders</field>
        <field name="model_id" ref="model_facility_booking"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_booking_complete" model="ir.cron">
        <field name="name">Facility Booking: Mark Completed</field>
        <field name="model_id" ref="model_facility_booking"/>
        <field name="state">code</field>
        <field name="code">model.cron_mark_completed()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_booking_expire" model="ir.cron">
        <field name="name">Facility Booking: Mark Expired</field>
        <field name="model_id" ref="model_facility_booking"/>
        <field name="state">code</field>
        <field name="code">model.cron_mark_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
