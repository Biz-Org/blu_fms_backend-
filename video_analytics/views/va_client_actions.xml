<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One OWL client action implementation: tag video_analytics_app. -->
    <record id="action_va_dashboard" model="ir.actions.client">
        <field name="name">Video Analytics Dashboard</field>
        <field name="tag">video_analytics_app</field>
        <field name="target">current</field>
        <field name="context">{'va_screen': 'dashboard'}</field>
        <field name="params" eval="{'screen': 'dashboard'}"/>
    </record>

