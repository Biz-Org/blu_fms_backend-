<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_video_analytics" model="ir.module.category">
        <field name="name">Video Analytics</field>
        <field name="sequence">52</field>
    </record>

    <record id="group_va_user" model="res.groups">
        <field name="name">Video Analytics User</field>
        <field name="category_id" ref="module_category_video_analytics"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_va_manager" model="res.groups">
        <field name="name">Video Analytics Manager</field>
        <field name="category_id" ref="module_category_video_analytics"/>
        <field name="implied_ids" eval="[(4, ref('group_va_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_va_admin" model="res.groups">
        <field name="name">Video Analytics Administrator</field>
        <field name="category_id" ref="module_category_video_analytics"/>
        <field name="implied_ids" eval="[(4, ref('group_va_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
