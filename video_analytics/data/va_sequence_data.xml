<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_va_event" model="ir.sequence">
        <field name="name">Video Event</field>
        <field name="code">va.event</field>
        <field name="prefix">VA-EVT</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_va_detection" model="ir.sequence">
        <field name="name">Video Detection</field>
        <field name="code">va.detection</field>
        <field name="prefix">VA-DET</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
