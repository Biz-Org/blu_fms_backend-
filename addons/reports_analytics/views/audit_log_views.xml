<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_analytics_audit_log_list" model="ir.ui.view">
        <field name="name">analytics.audit.log.list</field>
        <field name="model">analytics.audit.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="event_datetime"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="description"/>
                <field name="report_id"/>
                <field name="dashboard_id"/>
                <field name="related_module"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_analytics_audit_log_form" model="ir.ui.view">
        <field name="name">analytics.audit.log.form</field>
        <field name="model">analytics.audit.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="event_datetime"/>
                            <field name="user_id"/>
                            <field name="action"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="report_id"/>
                            <field name="alert_id"/>
                            <field name="kpi_id"/>
                            <field name="schedule_id"/>
                            <field name="related_module"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Change details">
                        <field name="previous_value"/>
                        <field name="new_value"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_analytics_audit_log_search" model="ir.ui.view">
        <field name="name">analytics.audit.log.search</field>
        <field name="model">analytics.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="description"/>
                <field name="user_id"/>
                <field name="report_id"/>
                <field name="dashboard_id"/>
                <field name="related_module"/>
                <separator/>
                <filter string="Report runs" name="filter_run" domain="[('action', '=', 'run')]"/>
                <filter string="Updates" name="filter_write" domain="[('action', '=', 'write')]"/>
                <group>
                    <filter string="Action" name="group_action" context="{'group_by': 'action'}"/>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Module" name="group_module" context="{'group_by': 'related_module'}"/>
                    <filter string="Event Date" name="group_event_date" context="{'group_by': 'event_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_analytics_audit_log" model="ir.actions.act_window">
        <field name="name">Audit History</field>
        <field name="res_model">analytics.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_analytics_audit_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No audit events yet
            </p>
            <p>
                Analytics audit history records configuration changes and report activity for traceability.
            </p>
        </field>
    </record>
</odoo>
