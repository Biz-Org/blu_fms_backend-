<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_analytics_kpi_list" model="ir.ui.view">
        <field name="name">analytics.kpi.list</field>
        <field name="model">analytics.kpi</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="target"/>
                <field name="aggregation"/>
                <field name="data_source_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_analytics_kpi_form" model="ir.ui.view">
        <field name="name">analytics.kpi.form</field>
        <field name="model">analytics.kpi</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="target"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="aggregation"/>
                            <field name="data_source_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Calculation configuration">
                        <field name="source_model"/>
                        <field name="measure_field"/>
                        <field name="source_domain" placeholder="[('state', '=', 'done')]"/>
                        <field name="unit"/>
                        <field name="higher_is_better"/>
                        <field name="config_notes"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Describe what this KPI measures..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_analytics_kpi_search" model="ir.ui.view">
        <field name="name">analytics.kpi.search</field>
        <field name="model">analytics.kpi</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="data_source_id"/>
                <field name="source_model"/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Data Source" name="group_data_source" context="{'group_by': 'data_source_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_analytics_kpi" model="ir.actions.act_window">
        <field name="name">KPIs</field>
        <field name="res_model">analytics.kpi</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_analytics_kpi_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a KPI
            </p>
            <p>
                KPI definitions store targets and future calculation settings without duplicating operational data.
            </p>
        </field>
    </record>
</odoo>
