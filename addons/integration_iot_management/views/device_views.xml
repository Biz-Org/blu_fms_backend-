<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iot_device_list" model="ir.ui.view">
        <field name="name">integration.iot.device.list</field>
        <field name="model">integration.iot.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="device_type"/>
                <field name="status"/>
                <field name="building_id"/>
                <field name="last_seen"/>
            </list>
        </field>
    </record>
    <record id="view_iot_device_form" model="ir.ui.view">
        <field name="name">integration.iot.device.form</field>
        <field name="model">integration.iot.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate"/>
                    <button name="action_deactivate" type="object" string="Deactivate"/>
                    <button name="action_archive" type="object" string="Archive"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="device_type"/>
                        <field name="integration_id"/>
                        <field name="property_id"/>
                        <field name="building_id"/>
                        <field name="area_id"/>
                        <field name="control_supported"/>
                        <field name="health_score"/>
                        <field name="active"/>
                        <field name="archived"/>
                    </group>
                    <group>
                        <field name="power_state"/>
                        <field name="brightness"/>
                        <field name="hvac_mode"/>
                        <field name="hvac_setpoint"/>
                        <field name="fire_alarm_condition"/>
                        <field name="settings_note"/>
                        <field name="replaced_by_id"/>
                        <field name="note"/>
                    </group>
                    <field name="sensor_ids">
                        <list>
                            <field name="name"/>
                            <field name="parameter"/>
                            <field name="last_value"/>
                            <field name="unit"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_iot_device" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">integration.iot.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
