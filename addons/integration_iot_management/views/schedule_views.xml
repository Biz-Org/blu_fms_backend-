<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iot_schedule_list" model="ir.ui.view">
        <field name="name">integration.iot.schedule.list</field>
        <field name="model">integration.iot.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="system_kind"/>
                <field name="lighting_action"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_iot_schedule_form" model="ir.ui.view">
        <field name="name">integration.iot.schedule.form</field>
        <field name="model">integration.iot.schedule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="system_kind"/>
                        <field name="device_id"/>
                        <field name="property_id"/>
                        <field name="building_id"/>
                        <field name="area_id"/>
                        <field name="lighting_action"/>
                        <field name="hvac_setpoint"/>
                        <field name="start_time" widget="float_time"/>
                        <field name="end_time" widget="float_time"/>
                        <field name="active"/>
                    </group>
                    <group string="Repeat days">
                        <field name="day_mon"/>
                        <field name="day_tue"/>
                        <field name="day_wed"/>
                        <field name="day_thu"/>
                        <field name="day_fri"/>
                        <field name="day_sat"/>
                        <field name="day_sun"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_iot_schedule" model="ir.actions.act_window">
        <field name="name">Schedules</field>
        <field name="res_model">integration.iot.schedule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
