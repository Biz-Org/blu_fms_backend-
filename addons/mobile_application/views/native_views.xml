<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_mobile_profiles" model="ir.actions.act_window">
        <field name="name">Mobile Profiles</field>
        <field name="res_model">mobile.application.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_mobile_profile_list" model="ir.ui.view">
        <field name="name">mobile.application.profile.list</field>
        <field name="model">mobile.application.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="building_label"/>
                <field name="unit_label"/>
                <field name="push_enabled"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_profile_form" model="ir.ui.view">
        <field name="name">mobile.application.profile.form</field>
        <field name="model">mobile.application.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="building_label"/>
                        <field name="unit_label"/>
                        <field name="push_provider"/>
                        <field name="push_enabled"/>
                        <field name="notification_prefs"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
