<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fs_contact_list" model="ir.ui.view">
        <field name="name">fire.safety.contact.list</field>
        <field name="model">fire.safety.contact</field>
        <field name="arch" type="xml">
            <list class="o_fs_app">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="role"/>
                <field name="phone" widget="phone"/>
                <field name="email"/>
                <field name="property_id"/>
            </list>
        </field>
    </record>
    <record id="view_fs_contact_form" model="ir.ui.view">
        <field name="name">fire.safety.contact.form</field>
        <field name="model">fire.safety.contact</field>
        <field name="arch" type="xml">
            <form class="o_fs_app">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="role"/>
                        <field name="phone" widget="phone"/>
                        <field name="email"/>
                        <field name="sequence"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="property_id"/>
                        <field name="active"/>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fs_contact" model="ir.actions.act_window">
        <field name="name">Emergency Contacts</field>
        <field name="res_model">fire.safety.contact</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
