<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fs_drill_search" model="ir.ui.view">
        <field name="name">fire.safety.drill.search</field>
        <field name="model">fire.safety.drill</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Scheduled" name="scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="Upcoming" name="upcoming" domain="[('state', '=', 'scheduled')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
            </search>
        </field>
    </record>
    <record id="view_fs_drill_list" model="ir.ui.view">
        <field name="name">fire.safety.drill.list</field>
        <field name="model">fire.safety.drill</field>
        <field name="arch" type="xml">
            <list class="o_fs_app">
                <field name="name"/>
                <field name="drill_type"/>
                <field name="scheduled_datetime"/>
                <field name="conducted_by"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_fs_drill_form" model="ir.ui.view">
        <field name="name">fire.safety.drill.form</field>
        <field name="model">fire.safety.drill</field>
        <field name="arch" type="xml">
            <form class="o_fs_app">
                <header>
                    <button name="action_notify_participants" type="object" string="Notify Participants" invisible="state not in ('scheduled', 'rescheduled')"/>
                    <button name="action_complete_drill" type="object" string="Complete" class="btn-primary" invisible="state not in ('scheduled', 'rescheduled')" groups="fire_safety_management.group_fire_safety_manager"/>
                    <button name="action_open_reschedule" type="object" string="Reschedule" invisible="state != 'scheduled'" groups="fire_safety_management.group_fire_safety_manager"/>
                    <button name="action_confirm_reschedule" type="object" string="Confirm Schedule" invisible="state != 'rescheduled'" groups="fire_safety_management.group_fire_safety_manager"/>
                    <button name="action_cancel_drill" type="object" string="Cancel" invisible="state not in ('scheduled', 'rescheduled')" groups="fire_safety_management.group_fire_safety_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,rescheduled,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Drill name"/></h1></div>
                    <group>
                        <group>
                            <field name="drill_type"/>
                            <field name="scheduled_datetime"/>
                            <field name="conducted_by"/>
                            <field name="expected_participants"/>
                            <field name="target_participation"/>
                            <field name="participant_ids" widget="many2many_tags" options="{'no_create': True}" string="Participants / Users"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="property_id"/>
                            <field name="building_id"/>
                            <field name="area_id"/>
                            <field name="assigned_user_id"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <notebook>
                        <page string="Completion">
                            <group>
                                <field name="attendance_count"/>
                                <field name="participation_rate"/>
                                <field name="response_time_minutes"/>
                                <field name="completed_datetime"/>
                            </group>
                            <field name="observations"/>
                            <field name="issues"/>
                        </page>
                        <page string="Cancellation" invisible="state != 'cancelled'">
                            <field name="cancelled_reason"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_fs_drill_reschedule_form" model="ir.ui.view">
        <field name="name">fire.safety.drill.reschedule.form</field>
        <field name="model">fire.safety.drill.reschedule</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="drill_id" readonly="1"/>
                    <field name="new_datetime"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reschedule" class="btn-primary"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_fs_drill" model="ir.actions.act_window">
        <field name="name">Mock Drills</field>
        <field name="res_model">fire.safety.drill</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_upcoming': 1}</field>
    </record>
</odoo>
