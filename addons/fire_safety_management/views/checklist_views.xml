<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fs_checklist_template_list" model="ir.ui.view">
        <field name="name">fire.safety.checklist.template.list</field>
        <field name="model">fire.safety.checklist.template</field>
        <field name="arch" type="xml">
            <list class="o_fs_app">
                <field name="name"/>
                <field name="code"/>
                <field name="inspection_type"/>
                <field name="item_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_fs_checklist_template_form" model="ir.ui.view">
        <field name="name">fire.safety.checklist.template.form</field>
        <field name="model">fire.safety.checklist.template</field>
        <field name="arch" type="xml">
            <form class="o_fs_app">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="inspection_type"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <field name="item_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="required"/>
                            <field name="guidance"/>
                        </list>
                    </field>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fs_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">fire.safety.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
