<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fs_property_list" model="ir.ui.view">
        <field name="name">fire.safety.property.list</field>
        <field name="model">fire.safety.property</field>
        <field name="arch" type="xml">
            <list class="o_fs_app">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_fs_property_form" model="ir.ui.view">
        <field name="name">fire.safety.property.form</field>
        <field name="model">fire.safety.property</field>
        <field name="arch" type="xml">
            <form class="o_fs_app">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Property name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Buildings">
                            <field name="building_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Integration">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fs_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">fire.safety.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_fs_building_list" model="ir.ui.view">
        <field name="name">fire.safety.building.list</field>
        <field name="model">fire.safety.building</field>
        <field name="arch" type="xml">
            <list class="o_fs_app">
                <field name="name"/>
                <field name="code"/>
                <field name="property_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_fs_building_form" model="ir.ui.view">
        <field name="name">fire.safety.building.form</field>
        <field name="model">fire.safety.building</field>
        <field name="arch" type="xml">
            <form class="o_fs_app">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="property_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Areas">
                            <field name="area_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="area_kind"/>
                                    <field name="code"/>
                                </list>
                            </field>
                        </page>
                        <page string="Integration">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fs_building" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">fire.safety.building</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_fs_area_list" model="ir.ui.view">
        <field name="name">fire.safety.area.list</field>
        <field name="model">fire.safety.area</field>
        <field name="arch" type="xml">
            <list class="o_fs_app">
                <field name="name"/>
                <field name="area_kind"/>
                <field name="building_id"/>
                <field name="property_id"/>
            </list>
        </field>
    </record>
    <record id="view_fs_area_form" model="ir.ui.view">
        <field name="name">fire.safety.area.form</field>
        <field name="model">fire.safety.area</field>
        <field name="arch" type="xml">
            <form class="o_fs_app">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="area_kind"/>
                        <field name="building_id"/>
                        <field name="property_id"/>
                        <field name="active"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fs_area" model="ir.actions.act_window">
        <field name="name">Areas</field>
        <field name="res_model">fire.safety.area</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
