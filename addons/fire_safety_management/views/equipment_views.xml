<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fs_equipment_search" model="ir.ui.view">
        <field name="name">fire.safety.equipment.search</field>
        <field name="model">fire.safety.equipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Operational" name="operational" domain="[('state', '=', 'operational')]"/>
                <filter string="Inspection Due" name="inspection_due" domain="[('state', '=', 'inspection_due')]"/>
                <filter string="Service Due" name="service_due" domain="[('state', '=', 'service_due')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
            </search>
        </field>
    </record>
    <record id="view_fs_equipment_list" model="ir.ui.view">
        <field name="name">fire.safety.equipment.list</field>
        <field name="model">fire.safety.equipment</field>
        <field name="arch" type="xml">
            <list class="o_fs_app">
                <field name="code"/>
                <field name="name"/>
                <field name="equipment_type"/>
                <field name="property_id"/>
                <field name="inspection_due_date"/>
                <field name="service_due_date"/>
                <field name="expiry_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_fs_equipment_form" model="ir.ui.view">
        <field name="name">fire.safety.equipment.form</field>
        <field name="model">fire.safety.equipment</field>
        <field name="arch" type="xml">
            <form class="o_fs_app">
                <header>
                    <button name="action_mark_operational" type="object" string="Mark Operational" invisible="condition == 'operational'" groups="fire_safety_management.group_fire_safety_manager"/>
                    <button name="action_mark_under_maintenance" type="object" string="Under Maintenance" groups="fire_safety_management.group_fire_safety_manager"/>
                    <button name="action_mark_faulty" type="object" string="Mark Faulty" groups="fire_safety_management.group_fire_safety_manager"/>
                    <button name="action_mark_replaced" type="object" string="Mark Replaced" groups="fire_safety_management.group_fire_safety_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="equipment_type"/>
                            <field name="condition"/>
                            <field name="install_date"/>
                            <field name="inspection_due_date"/>
                            <field name="service_due_date"/>
                            <field name="expiry_date"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="property_id"/>
                            <field name="building_id"/>
                            <field name="area_id"/>
                            <field name="location_detail"/>
                            <field name="assigned_user_id"/>
                            <field name="last_inspection_date"/>
                            <field name="last_service_date"/>
                        </group>
                    </group>
                    <field name="notes"/>
                    <notebook>
                        <page string="Service / Replacement History">
                            <field name="history_ids">
                                <list editable="bottom">
                                    <field name="event_date"/>
                                    <field name="event_type"/>
                                    <field name="summary"/>
                                    <field name="performed_by_id"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_fs_equipment" model="ir.actions.act_window">
        <field name="name">Fire Equipment</field>
        <field name="res_model">fire.safety.equipment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
