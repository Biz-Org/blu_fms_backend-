<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fs_incident_search" model="ir.ui.view">
        <field name="name">fire.safety.incident.search</field>
        <field name="model">fire.safety.incident</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="incident_type"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Investigating" name="investigating" domain="[('state', '=', 'investigating')]"/>
                <filter string="Resolved" name="resolved" domain="[('state', '=', 'resolved')]"/>
            </search>
        </field>
    </record>
    <record id="view_fs_incident_list" model="ir.ui.view">
        <field name="name">fire.safety.incident.list</field>
        <field name="model">fire.safety.incident</field>
        <field name="arch" type="xml">
            <list class="o_fs_app">
                <field name="name"/>
                <field name="incident_type"/>
                <field name="severity"/>
                <field name="incident_datetime"/>
                <field name="reported_by_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_fs_incident_form" model="ir.ui.view">
        <field name="name">fire.safety.incident.form</field>
        <field name="model">fire.safety.incident</field>
        <field name="arch" type="xml">
            <form class="o_fs_app">
                <header>
                    <button name="action_start_investigation" type="object" string="Investigate" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_resolve_incident" type="object" string="Resolve" invisible="state != 'investigating'" groups="fire_safety_management.group_fire_safety_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,investigating,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="incident_type"/>
                            <field name="severity"/>
                            <field name="incident_datetime"/>
                            <field name="reported_by_id"/>
                            <field name="assigned_user_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="property_id"/>
                            <field name="building_id"/>
                            <field name="area_id"/>
                            <field name="site_id" readonly="1"/>
                            <field name="department_id"/>
                            <field name="location_detail"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Report">
                            <field name="description"/>
                            <field name="immediate_action"/>
                            <field name="evidence_ids" widget="many2many_binary"/>
                        </page>
                        <page string="People Involved">
                            <field name="person_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="role"/>
                                    <field name="contact"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Investigation">
                            <field name="investigation_notes"/>
                            <field name="root_cause"/>
                            <field name="finding_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="severity"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_fs_incident" model="ir.actions.act_window">
        <field name="name">Safety Incidents</field>
        <field name="res_model">fire.safety.incident</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
