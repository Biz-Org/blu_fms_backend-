<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fs_procedure_list" model="ir.ui.view">
        <field name="name">fire.safety.procedure.list</field>
        <field name="model">fire.safety.procedure</field>
        <field name="arch" type="xml">
            <list class="o_fs_app">
                <field name="name"/>
                <field name="code"/>
                <field name="procedure_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_fs_procedure_form" model="ir.ui.view">
        <field name="name">fire.safety.procedure.form</field>
        <field name="model">fire.safety.procedure</field>
        <field name="arch" type="xml">
            <form class="o_fs_app">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="procedure_type"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <field name="summary"/>
                    <field name="body"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_fs_procedure" model="ir.actions.act_window">
        <field name="name">Procedures</field>
        <field name="res_model">fire.safety.procedure</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
