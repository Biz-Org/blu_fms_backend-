        <field name="model_id" ref="model_fire_safety_incident"/>
        <field name="groups" eval="[(4, ref('group_fire_safety_manager')), (4, ref('group_fire_safety_security')), (4, ref('group_fire_safety_facility')), (4, ref('group_fire_safety_auditor')), (4, ref('group_fire_safety_executive'))]"/>
