<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="community_communication.Polls">
        <div class="o_action o_cc_app">
            <CcAppShell active="'polls'">
            <div class="o_cc_shell">
                <t t-if="state.mode === 'list'">
                    <CcPageHeader title="'Polls'" subtitle="'Create and manage community polls to understand resident preferences.'">
                        <t t-set-slot="buttons">
                            <CcActionButton t-if="state.isOfficer" label="'+ Create Poll'" icon="'fa-plus'" onClick="() => this.setMode('create')"/>
                        </t>
                    </CcPageHeader>
                    <div class="o_cc_kpi_row">
                        <t t-foreach="state.kpis" t-as="card" t-key="card.key">
                            <CcKpiCard label="card.label" value="card.value" icon="'fa-bar-chart'"/>
                        </t>
                    </div>
                    <div class="o_cc_card">
                        <CcTabs items="tabs" active="state.filter" onSelect="(id) => { this.state.filter = id; this.state.page = 1; this.reload(); }"/>
                        <div class="o_cc_toolbar">
                            <CcSearchBar value="state.search" placeholder="'Search polls...'" onChange.bind="onSearch"/>
                            <select class="o_cc_select" t-model="state.category" t-on-change="() => this.reload()">
                                <option value="">Category: All</option>
                                <t t-foreach="categories" t-as="cat" t-key="cat[0]"><option t-att-value="cat[0]" t-esc="cat[1]"/></t>
                            </select>
                            <select class="o_cc_select" t-model="state.audience" t-on-change="() => this.reload()">
                                <option value="">Audience: All</option>
                                <option value="community">Entire Community</option>
                                <option value="buildings">Buildings</option>
                                <option value="groups">Groups</option>
                            </select>
                        </div>
                        <t t-if="state.records.length">
                            <table class="o_cc_table">
                                <thead>
                                    <tr>
                                        <th>Poll</th>
                                        <th>Type</th>
                                        <th>Target Audience</th>
                                        <th>Participants</th>
                                        <th>Response Rate</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Status</th>
                                        <th t-if="state.isOfficer">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.records" t-as="rec" t-key="rec.id" t-on-click="() => this.openPoll(rec)">
                                        <td class="o_cc_row_title" t-esc="rec.question"/>
                                        <td t-esc="rec.response_type === 'single' ? 'Single Choice' : 'Multiple Choice'"/>
                                        <td t-esc="audienceText(rec)"/>
                                        <td t-esc="rec.participant_count"/>
                                        <td>
                                            <div class="o_cc_progress"><div class="o_cc_progress_bar" t-att-style="'width:' + ratePct(rec) + '%'"/></div>
                                            <div class="small"><t t-esc="ratePct(rec)"/>%</div>
                                        </td>
                                        <td t-esc="formatDay(rec.date_start)"/>
                                        <td t-esc="formatDay(rec.date_end)"/>
                                        <td><CcStatusBadge state="rec.state"/></td>
                                        <td t-if="state.isOfficer">
                                            <button class="o_cc_link" t-on-click.stop="() => this.setMode('results', rec.id)">View Results</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <CcPagination page="state.page" total="state.total" pageSize="pageSize" onPage.bind="onPage"/>
                        </t>
                        <CcEmptyState t-else="" title="'No polls yet'" hint="state.isOfficer ? 'Create a poll to collect resident preferences.' : 'Active polls will appear here.'" actionLabel="state.isOfficer ? '+ Create Poll' : ''" onAction="() => this.setMode('create')"/>
                    </div>
                </t>

                <t t-if="state.mode === 'create' or state.mode === 'edit'">
                    <CcPageHeader title="'Create Poll'">
                        <t t-set-slot="buttons">
                            <button class="o_cc_btn ghost" t-att-disabled="state.busy" t-on-click="() => this.setMode('list')">Cancel</button>
                            <button class="o_cc_btn secondary" t-att-disabled="state.busy" t-on-click="() => this.save(false)">Save Draft</button>
                            <button class="o_cc_btn primary" t-att-disabled="state.busy" t-on-click="() => this.save(true)">Publish Poll</button>
                        </t>
                    </CcPageHeader>
                    <div class="o_cc_split">
                        <div>
                            <CcFormSection title="'Poll Information'">
                                <label>Poll Question *</label>
                                <input t-att-class="fieldClass('question')" t-model="state.form.question" placeholder="e.g., What time should the community picnic start?"/>
                                <CcFieldError message="fieldError('question')"/>
                                <label class="mt-3">Description (Optional)</label>
                                <textarea t-model="state.form.description"/>
                                <label class="mt-3">Category</label>
                                <select class="o_cc_input" t-model="state.form.category">
                                    <t t-foreach="categories" t-as="cat" t-key="cat[0]"><option t-att-value="cat[0]" t-esc="cat[1]"/></t>
                                </select>
                                <label class="mt-3">Response Type</label>
                                <label class="o_cc_radio"><input type="radio" t-model="state.form.response_type" value="single"/> Single Choice</label>
                                <label class="o_cc_radio"><input type="radio" t-model="state.form.response_type" value="multiple"/> Multiple Choice</label>
                            </CcFormSection>
                            <CcFormSection title="'Response Options'">
                                <t t-foreach="state.form.options or []" t-as="opt" t-key="opt_index">
                                    <div class="d-flex gap-2 mb-2">
                                        <input class="o_cc_input" t-att-value="opt" t-on-input="(ev) => this.setOption(opt_index, ev)" placeholder="Option"/>
                                        <button class="o_cc_btn ghost" t-on-click="() => this.removeOption(opt_index)"><i class="fa fa-trash"/></button>
                                    </div>
                                </t>
                                <button class="o_cc_link" t-on-click="addOption">+ Add Option</button>
                                <CcFieldError message="fieldError('options')"/>
                            </CcFormSection>
                            <div class="o_cc_two">
                                <CcFormSection title="'Settings'">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span>Anonymous Voting</span>
                                        <button t-att-class="state.form.anonymous ? 'o_cc_switch on' : 'o_cc_switch'" t-on-click="() => this.toggle('anonymous')"/>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>Limit 1 Response / Unit</span>
                                        <button t-att-class="state.form.one_per_unit ? 'o_cc_switch on' : 'o_cc_switch'" t-on-click="() => this.toggle('one_per_unit')"/>
                                    </div>
                                </CcFormSection>
                                <CcFormSection title="'Audience'">
                                    <CcAudiencePicker
                                        audienceType="state.form.audience_type"
                                        onType.bind="setAudienceType"
                                        buildings="buildingsFor(communityId)"
                                        groups="groupsFor(communityId)"
                                        buildingIds="state.form.building_ids"
                                        groupIds="state.form.audience_group_ids"
                                        buildingQuery="state.form.buildingQuery"
                                        groupQuery="state.form.groupQuery"
                                        onBuildingQuery.bind="setBuildingQuery"
                                        onGroupQuery.bind="setGroupQuery"
                                        onToggleBuilding.bind="toggleBuilding"
                                        onToggleGroup.bind="toggleGroup"
                                        error="fieldError('audience')"
                                        radioName="'poll-audience'"/>
                                </CcFormSection>
                            </div>
                            <CcFormSection title="'Schedule'">
                                <div class="o_cc_form_grid">
                                    <div>
                                        <label>Start Date &amp; Time</label>
                                        <input class="o_cc_input" type="datetime-local" t-model="state.form.date_start"/>
                                    </div>
                                    <div>
                                        <label>End Date &amp; Time</label>
                                        <input t-att-class="fieldClass('date_end')" type="datetime-local" t-model="state.form.date_end"/>
                                        <CcFieldError message="fieldError('date_end')"/>
                                    </div>
                                </div>
                            </CcFormSection>
                        </div>
                        <CcPreviewPanel title="state.form.question" body="previewBody()" category="categoryLabel(state.form.category)" extra="state.form.anonymous ? 'Anonymous Voting Enabled' : 'Named voting'" meta="audiencePreviewLabel()">
                            <t t-foreach="state.form.options or []" t-as="opt" t-key="opt_index">
                                <div t-if="opt" class="o_cc_option" t-esc="opt"/>
                            </t>
                        </CcPreviewPanel>
                    </div>
                </t>

                <t t-if="state.mode === 'vote' and state.extras.vote">
                    <button class="o_cc_back" t-on-click="() => this.setMode('list')">Polls &gt; Vote</button>
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                        <h1 class="mb-0">Vote on Poll</h1>
                        <button t-if="state.isOfficer" class="o_cc_btn secondary" t-on-click="() => this.setMode('results', state.resId)">
                            <i class="fa fa-bar-chart"/> View Results
                        </button>
                    </div>
                    <div class="o_cc_split">
                        <div class="o_cc_card">
                            <span class="o_cc_pill" t-esc="categoryLabel(state.extras.vote.category)"/>
                            <h2 class="mt-2" t-esc="state.extras.vote.question"/>
                            <p t-esc="state.extras.vote.description"/>
                            <div class="o_cc_kpi_label mb-2">SELECT ONE OPTION</div>
                            <t t-foreach="state.extras.vote.options" t-as="opt" t-key="opt.id">
                                <div t-att-class="(state.extras.selected or []).includes(opt.id) ? 'o_cc_option selected' : 'o_cc_option'" t-on-click="() => this.selectOption(opt.id)" t-esc="opt.name"/>
                            </t>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="small text-muted" t-if="state.extras.vote.anonymous">
                                    <i class="fa fa-eye-slash"/> Anonymous Voting<br/>Your individual response will not be identified
                                </div>
                                <button class="o_cc_btn primary" t-att-disabled="state.extras.vote.has_voted or state.busy" t-on-click="submitVote">Submit Vote</button>
                            </div>
                        </div>
                        <div class="o_cc_stack">
                            <div class="o_cc_card">
                                <div class="o_cc_card_head">Poll Details</div>
                                <div class="small mb-2">CLOSING DATE<br/><b t-esc="formatWhen(state.extras.vote.date_end) or 'Open'"/></div>
                                <div class="small mb-2">AUDIENCE<br/><b t-esc="audienceText(state.extras.vote)"/></div>
                                <div class="small">RESPONSE TYPE<br/><b t-esc="state.extras.vote.response_type === 'single' ? 'Single Choice' : 'Multiple Choice'"/></div>
                            </div>
                            <div class="o_cc_cta">
                                <i class="fa fa-check-square-o"/> <b>Your Voice Matters</b>
                                <div class="small mt-1">Help shape community decisions by participating in active polls.</div>
                            </div>
                        </div>
                    </div>
                </t>

                <t t-if="state.mode === 'confirm' and state.extras.vote">
                    <div class="o_cc_card o_cc_confirm">
                        <div class="o_cc_confirm_icon"><i class="fa fa-check"/></div>
                        <h2>Your vote has been submitted</h2>
                        <p>Thank you for participating in the community poll.</p>
                        <div class="o_cc_form_section text-start">
                            <div class="o_cc_kpi_label">Poll Summary</div>
                            <div class="small text-muted mt-2">POLL TITLE</div>
                            <div class="fw-semibold" t-esc="state.extras.vote.question"/>
                            <div class="small text-muted mt-2">SELECTED RESPONSE</div>
                            <t t-foreach="selectedNames()" t-as="name" t-key="name"><div class="o_cc_pill" t-esc="name"/></t>
                            <div class="small text-muted mt-2">SUBMISSION TIMESTAMP</div>
                            <div t-esc="formatWhen(state.extras.confirmedAt)"/>
                        </div>
                        <div class="d-flex justify-content-center gap-2 mt-3">
                            <button class="o_cc_btn primary" t-on-click="() => this.setMode('list')"><i class="fa fa-arrow-left"/> Back to Polls</button>
                            <button class="o_cc_btn secondary" t-on-click="() => this.setMode('results', state.resId)"><i class="fa fa-bar-chart"/> View Results</button>
                        </div>
                    </div>
                </t>

                <t t-if="state.mode === 'results' and state.extras.vote">
                    <button class="o_cc_back" t-on-click="() => this.setMode('list')">Polls &gt; Results</button>
                    <CcPageHeader title="state.extras.vote.question" subtitle="'Poll results based on submitted votes.'">
                        <t t-set-slot="buttons">
                            <button class="o_cc_btn secondary" t-if="state.isOfficer" t-on-click="exportResults">Export</button>
                            <button t-if="state.isOfficer and state.extras.vote.state === 'active'" class="o_cc_btn primary" t-on-click="closePoll">Close Poll</button>
                        </t>
                    </CcPageHeader>
                    <div class="o_cc_card">
                        <div class="small text-muted mb-3"><t t-esc="state.extras.vote.participant_count"/> participants</div>
                        <t t-foreach="state.extras.vote.options" t-as="opt" t-key="opt.id">
                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <span t-esc="opt.name"/>
                                    <span><t t-esc="opt.vote_count"/> · <t t-esc="opt.vote_percent"/>%</span>
                                </div>
                                <div class="o_cc_progress"><div class="o_cc_progress_bar" t-att-style="'width:' + opt.vote_percent + '%'"/></div>
                            </div>
                        </t>
                    </div>
                </t>

            </div>
            </CcAppShell>
        </div>
    </t>
</templates>
