<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="community_communication.Feedback">
        <div class="o_action o_cc_app">
            <CcAppShell active="'feedback'">
            <div class="o_cc_shell">
                <t t-if="state.mode === 'list'">
                    <CcPageHeader title="'Resident Feedback'" subtitle="'Review and respond to feedback submitted by residents.'">
                        <t t-set-slot="buttons">
                            <CcActionButton label="'+ Submit Feedback'" icon="'fa-plus'" onClick="() => this.setMode('create')"/>
                        </t>
                    </CcPageHeader>
                    <div class="o_cc_kpi_row">
                        <t t-foreach="state.kpis" t-as="card" t-key="card.key">
                            <CcKpiCard label="card.label" value="card.value" icon="'fa-inbox'" onClick="() => { this.state.filter = card.filter || card.key; this.reload(); }"/>
                        </t>
                    </div>
                    <div class="o_cc_card">
                        <div class="d-flex justify-content-between flex-wrap gap-2">
                            <CcTabs items="tabs" active="state.filter" onSelect="(id) => { this.state.filter = id; this.state.page = 1; this.reload(); }"/>
                            <div class="o_cc_toolbar mb-0">
                                <CcSearchBar value="state.search" placeholder="'Search feedback ID or subject...'" onChange.bind="onSearch"/>
                                <button t-if="state.isOfficer" class="o_cc_btn ghost" t-on-click="exportList"><i class="fa fa-download"/></button>
                            </div>
                        </div>
                        <t t-if="state.records.length">
                            <table class="o_cc_table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Subject / Category</th>
                                        <th>Submitted By</th>
                                        <th>Created</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.records" t-as="rec" t-key="rec.id" t-on-click="() => this.setMode('detail', rec.id)">
                                        <td t-esc="rec.name"/>
                                        <td>
                                            <div class="o_cc_row_title" t-esc="rec.subject"/>
                                            <div class="o_cc_row_sub" t-esc="categoryLabel(rec.category)"/>
                                        </td>
                                        <td t-esc="residentLabel(rec)"/>
                                        <td t-esc="formatDay(rec.create_date)"/>
                                        <td><CcStatusBadge state="rec.state"/></td>
                                        <td><button class="o_cc_link">View</button></td>
                                    </tr>
                                </tbody>
                            </table>
                            <CcPagination page="state.page" total="state.total" pageSize="pageSize" onPage.bind="onPage"/>
                        </t>
                        <CcEmptyState t-else="" title="'No feedback yet'" hint="'Submitted feedback will appear in this list.'" actionLabel="'+ Submit Feedback'" onAction="() => this.setMode('create')"/>
                    </div>
                </t>

                <t t-if="state.mode === 'create'">
                    <button class="o_cc_back" t-on-click="() => this.setMode('list')"><i class="fa fa-arrow-left"/> Back to Feedback List</button>
                    <CcPageHeader title="'Submit Feedback'" subtitle="'Tell management about an issue or suggestion.'"/>
                    <div class="o_cc_split">
                        <CcFormSection title="'Feedback Details'">
                            <label>Subject *</label>
                            <input t-att-class="fieldClass('subject')" t-model="state.form.subject"/>
                            <CcFieldError message="fieldError('subject')"/>
                            <label class="mt-3">Category</label>
                            <select class="o_cc_input" t-model="state.form.category">
                                <t t-foreach="categories" t-as="cat" t-key="cat[0]"><option t-att-value="cat[0]" t-esc="cat[1]"/></t>
                            </select>
                            <label class="mt-3">Description *</label>
                            <textarea t-att-class="fieldClass('description')" t-model="state.form.description"/>
                            <CcFieldError message="fieldError('description')"/>
                            <label class="mt-3">Attachments</label>
                            <CcFileDropzone files="attachmentList" error="fieldError('attachments')" onAdd.bind="onFilesSelected" onRemove.bind="removeAttachment"/>
                            <label class="o_cc_radio mt-2"><input type="checkbox" t-model="state.form.anonymous"/> Submit anonymously</label>
                            <div class="o_cc_footer_actions">
                                <span t-if="state.busy" class="o_cc_busy_hint" t-esc="state.busy"/>
                                <button class="o_cc_btn primary" t-att-disabled="state.busy" t-on-click="submit">Submit</button>
                            </div>
                        </CcFormSection>
                        <CcPreviewPanel title="state.form.subject" body="stripHtml(state.form.description).slice(0, 160)" category="categoryLabel(state.form.category)"/>
                    </div>
                </t>

                <t t-if="state.mode === 'detail' and state.record">
                    <button class="o_cc_back" t-on-click="() => this.setMode('list')"><i class="fa fa-arrow-left"/> Back to Feedback List</button>
                    <h1 t-esc="state.record.subject"/>
                    <div class="o_cc_meta mb-3">
                        <span t-esc="categoryLabel(state.record.category)"/>
                        <span t-esc="formatWhen(state.record.create_date)"/>
                        <span t-esc="residentLabel(state.record)"/>
                    </div>
                    <div class="o_cc_split">
                        <div class="o_cc_stack">
                            <div class="o_cc_card">
                                <div t-out="html(state.record.description)"/>
                                <t t-foreach="state.extras.attachments or []" t-as="file" t-key="file.id">
                                    <div class="o_cc_file_row">
                                        <i class="fa fa-file-o"/>
                                        <span class="flex-grow-1" t-esc="file.name"/>
                                        <a t-att-href="'/web/content/' + file.id + '?download=1'"><i class="fa fa-download"/></a>
                                    </div>
                                </t>
                            </div>
                            <div t-if="state.isOfficer" class="o_cc_card">
                                <div class="o_cc_card_head">Admin Actions</div>
                                <label>Update Status</label>
                                <select class="o_cc_input" t-model="state.form.status">
                                    <option value="submitted">Submitted</option>
                                    <option value="in_progress">In Progress</option>
                                    <option value="resolved">Resolved</option>
                                    <option value="closed">Closed</option>
                                </select>
                                <label class="mt-3">Respond to Resident</label>
                                <textarea t-model="state.form.response" placeholder="Type official response here..."/>
                                <button class="o_cc_btn primary mt-2" t-att-disabled="state.busy" t-on-click="respond">Update &amp; Respond</button>
                            </div>
                            <div t-if="state.isOfficer" class="o_cc_card">
                                <div class="o_cc_card_head"><i class="fa fa-lock"/> Internal Notes (Hidden from Resident)</div>
                                <textarea t-att-class="fieldClass('note')" t-model="state.form.note"/>
                                <CcFieldError message="fieldError('note')"/>
                                <button class="o_cc_btn secondary mt-2" t-att-disabled="state.busy" t-on-click="saveNote">Save Note</button>
                                <t t-foreach="state.extras.notes or []" t-as="note" t-key="note.id">
                                    <div class="o_cc_thread_comment">
                                        <div class="small text-muted" t-esc="m2oName(note.author_id) + ' · ' + formatWhen(note.create_date)"/>
                                        <div t-esc="note.body"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div class="o_cc_stack">
                            <div class="o_cc_card">
                                <div class="o_cc_card_head">Status</div>
                                <CcStatusBadge state="state.record.state"/>
                            </div>
                            <div class="o_cc_card">
                                <div class="o_cc_card_head">Management Response</div>
                                <t t-foreach="state.extras.responses or []" t-as="resp" t-key="resp.id">
                                    <div class="o_cc_form_section">
                                        <div t-out="html(resp.body)"/>
                                        <div class="small text-muted" t-esc="formatWhen(resp.create_date)"/>
                                    </div>
                                </t>
                                <div t-if="!(state.extras.responses or []).length" class="text-muted small">No response yet.</div>
                            </div>
                            <div class="o_cc_card">
                                <div class="o_cc_card_head">Activity</div>
                                <ul class="o_cc_timeline">
                                    <li>Feedback submitted · <t t-esc="formatDay(state.record.create_date)"/></li>
                                    <li>Status: <t t-esc="state.record.state"/></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
            </CcAppShell>
        </div>
    </t>
</templates>
