<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cc_event_calendar" model="ir.ui.view">
        <field name="name">community.communication.event.calendar</field>
        <field name="model">community.communication.event</field>
        <field name="arch" type="xml">
            <calendar string="Events" date_start="date_start" date_stop="date_end" mode="month" scales="week,month" color="category" event_open_popup="1" quick_create="0">
                <field name="name"/>
                <field name="category"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>
    <record id="view_cc_event_list" model="ir.ui.view">
        <field name="name">community.communication.event.list</field>
        <field name="model">community.communication.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="venue_id"/>
                <field name="confirmed_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_cc_event_form" model="ir.ui.view">
        <field name="name">community.communication.event.form</field>
        <field name="model">community.communication.event</field>
        <field name="arch" type="xml">
            <form class="o_cc_shell">
                <header>
                    <button name="action_publish" string="Publish" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_register" string="Register" type="object" class="btn-primary" invisible="state != 'published' or not require_registration"/>
                    <button name="action_cancel" string="Cancel Event" type="object" invisible="state not in ('draft', 'published')"/>
                    <button name="action_complete" string="Complete" type="object" invisible="state != 'published'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,completed"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="community_id" invisible="1"/>
                            <field name="building_id"/>
                            <field name="venue_id"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="require_registration"/>
                            <field name="date_deadline" invisible="not require_registration"/>
                            <field name="capacity" invisible="not require_registration"/>
                            <field name="confirmed_count"/>
                            <field name="spots_available" invisible="not capacity"/>
                            <field name="reminder_enabled"/>
                            <field name="audience_type"/>
                            <field name="building_ids" widget="many2many_tags" invisible="audience_type != 'buildings'"/>
                            <field name="audience_group_ids" widget="many2many_tags" invisible="audience_type != 'groups'"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <widget name="cc_event_rsvp"/>
                    <notebook>
                        <page string="Attendees" name="attendees">
                            <field name="registration_ids">
                                <list>
                                    <field name="resident_id"/>
                                    <field name="unit_id"/>
                                    <field name="registered_on"/>
                                    <field name="state"/>
                                    <field name="waitlist_rank"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_cc_event_search" model="ir.ui.view">
        <field name="name">community.communication.event.search</field>
        <field name="model">community.communication.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Upcoming" name="upcoming" domain="[('state', '=', 'published')]"/>
                <filter string="Past" name="past" domain="[('state', '=', 'completed')]"/>
                <group>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_cc_event" model="ir.actions.act_window">
        <field name="name">Event Calendar</field>
        <field name="res_model">community.communication.event</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_upcoming': 1}</field>
    </record>

    <record id="view_cc_registration_list" model="ir.ui.view">
        <field name="name">community.communication.event.registration.list</field>
        <field name="model">community.communication.event.registration</field>
        <field name="arch" type="xml">
            <list>
                <field name="event_id"/>
                <field name="resident_id"/>
                <field name="unit_id"/>
                <field name="registered_on"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_cc_registration_form" model="ir.ui.view">
        <field name="name">community.communication.event.registration.form</field>
        <field name="model">community.communication.event.registration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state not in ('pending', 'waitlisted')"/>
                    <button name="action_waitlist" string="Waitlist" type="object" invisible="state != 'pending'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state not in ('pending', 'waitlisted')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('cancelled', 'attended', 'rejected')"/>
                    <button name="action_attended" string="Mark Attended" type="object" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="event_id"/>
                        <field name="resident_id"/>
                        <field name="community_id" invisible="1"/>
                        <field name="registered_on"/>
                        <field name="waitlist_rank" invisible="state != 'waitlisted'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_cc_registration" model="ir.actions.act_window">
        <field name="name">Event Registration</field>
        <field name="res_model">community.communication.event.registration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
