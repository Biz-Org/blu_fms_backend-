<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ca_action_list" model="ir.ui.view">
        <field name="name">compliance.action.list</field>
        <field name="model">compliance.action</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="non_compliance_id"/>
                <field name="assigned_user_id"/>
                <field name="deadline"/>
                <field name="is_overdue"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_ca_action_form" model="ir.ui.view">
        <field name="name">compliance.action.form</field>
        <field name="model">compliance.action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_submit_verification" type="object" string="Submit for Verification" invisible="state != 'in_progress'"/>
                    <button name="action_verify" type="object" string="Verify" class="btn-primary" invisible="state != 'pending_verification'"/>
                    <button name="action_close" type="object" string="Close" invisible="state != 'verified'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="non_compliance_id"/>
                        <field name="assigned_user_id"/>
                        <field name="deadline"/>
                        <field name="company_id"/>
                        <field name="verified_by_id" readonly="1"/>
                        <field name="verified_datetime" readonly="1"/>
                    </group>
                    <field name="description"/>
                    <field name="verification_notes"/>
                    <field name="evidence_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_ca_action" model="ir.actions.act_window">
        <field name="name">Corrective Actions</field>
        <field name="res_model">compliance.action</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
