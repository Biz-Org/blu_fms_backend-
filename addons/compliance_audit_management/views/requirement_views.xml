<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ca_requirement_list" model="ir.ui.view">
        <field name="name">compliance.requirement.list</field>
        <field name="model">compliance.requirement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="regulatory_authority"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_ca_requirement_form" model="ir.ui.view">
        <field name="name">compliance.requirement.form</field>
        <field name="model">compliance.requirement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="regulatory_authority"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_ca_requirement" model="ir.actions.act_window">
        <field name="name">Compliance Requirements</field>
        <field name="res_model">compliance.requirement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
