<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ca_check_list" model="ir.ui.view">
        <field name="name">compliance.check.list</field>
        <field name="model">compliance.check</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="requirement_id"/>
                <field name="property_id"/>
                <field name="assigned_user_id"/>
                <field name="due_date"/>
                <field name="is_overdue"/>
                <field name="state" decoration-danger="is_overdue" decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>
    <record id="view_ca_check_form" model="ir.ui.view">
        <field name="name">compliance.check.form</field>
        <field name="model">compliance.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'scheduled'"/>
                    <button name="action_mark_pending" type="object" string="Mark Pending" invisible="state not in ('scheduled', 'in_progress')"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="state not in ('in_progress', 'pending')"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,in_progress,pending,completed"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="reference" readonly="1"/>
                        <field name="requirement_id"/>
                        <field name="template_id"/>
                        <field name="property_id"/>
                        <field name="building_id"/>
                        <field name="area_id"/>
                        <field name="assigned_user_id"/>
                        <field name="due_date"/>
                        <field name="repeat"/>
                        <field name="company_id"/>
                        <field name="is_overdue"/>
                    </group>
                    <field name="notes"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="required"/>
                            <field name="result"/>
                            <field name="remarks"/>
                        </list>
                    </field>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_ca_check" model="ir.actions.act_window">
        <field name="name">Compliance Activities</field>
        <field name="res_model">compliance.check</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
