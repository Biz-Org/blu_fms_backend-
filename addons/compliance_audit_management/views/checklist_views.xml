<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ca_checklist_tpl_list" model="ir.ui.view">
        <field name="name">compliance.checklist.template.list</field>
        <field name="model">compliance.checklist.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="item_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_ca_checklist_tpl_form" model="ir.ui.view">
        <field name="name">compliance.checklist.template.form</field>
        <field name="model">compliance.checklist.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="company_id"/>
                        <field name="active"/>
                        <field name="requirement_ids" widget="many2many_tags"/>
                    </group>
                    <field name="preview_text"/>
                    <field name="item_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="required"/>
                            <field name="guidance"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ca_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">compliance.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
