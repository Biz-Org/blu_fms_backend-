<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_compliance_check" model="ir.sequence">
        <field name="name">Compliance Check</field>
        <field name="code">compliance.check</field>
        <field name="prefix">CHK-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_compliance_audit" model="ir.sequence">
        <field name="name">Compliance Audit</field>
        <field name="code">compliance.audit</field>
        <field name="prefix">ADT-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_compliance_inspection" model="ir.sequence">
        <field name="name">Compliance Inspection</field>
        <field name="code">compliance.inspection</field>
        <field name="prefix">INS-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_compliance_nc" model="ir.sequence">
        <field name="name">Non-Compliance</field>
        <field name="code">compliance.non.compliance</field>
        <field name="prefix">NC-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_compliance_reg_report" model="ir.sequence">
        <field name="name">Regulatory Report</field>
        <field name="code">compliance.regulatory.report</field>
        <field name="prefix">REP-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
