<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="compliance_audit_management.NonCompliance">
        <div class="o_action o_ca_app">
            <CaAppShell active="'non_compliance'">
                <div class="o_ca_shell">
                    <div t-if="state.error" class="o_ca_alert">
                        <i class="fa fa-exclamation-circle"/>
                        <div t-esc="state.error"/>
                    </div>

                    <t t-if="state.mode === 'list'">
                        <div class="o_ca_page_header">
                            <div>
                                <h1>Non-Compliance</h1>
                                <p>Track issues, corrective actions, verification and closure.</p>
                            </div>
                            <button t-if="canManage" class="o_ca_btn primary" t-on-click="openCreate">
                                <i class="fa fa-plus"/> Log Issue
                            </button>
                        </div>

                        <div t-if="state.loading" class="o_ca_empty">
                            <h3>Loading issues</h3>
                            <p>Fetching non-compliance records.</p>
                        </div>
                        <t t-else="">
                            <div class="o_ca_kpi_row">
                                <CaKpiCard
                                    label="'Open Issues'"
                                    value="state.kpis.open"
                                    icon="'fa-exclamation-circle'"
                                    tone="state.kpis.open ? 'warning' : ''"
                                    onClick.bind="() => this.onFilter('open')"
                                />
                                <CaKpiCard
                                    label="'Overdue'"
                                    value="state.kpis.overdue"
                                    icon="'fa-clock-o'"
                                    tone="state.kpis.overdue ? 'danger' : ''"
                                    hint="state.kpis.overdue ? 'Past due date' : ''"
                                    onClick.bind="() => this.onFilter('overdue')"
                                />
                                <CaKpiCard
                                    label="'Pending Verification'"
                                    value="state.kpis.pending_verification"
                                    icon="'fa-search'"
                                    onClick.bind="() => this.onFilter('pending_verification')"
                                />
                                <CaKpiCard
                                    label="'High / Critical'"
                                    value="state.kpis.high_severity"
                                    icon="'fa-bolt'"
                                    tone="state.kpis.high_severity ? 'danger' : ''"
                                    onClick.bind="() => this.onFilter('high')"
                                />
                            </div>

                            <div class="o_ca_toolbar">
                                <div class="o_ca_chips">
                                    <button t-att-class="state.filter === 'all' ? 'active' : ''" t-on-click="() => this.onFilter('all')">All</button>
                                    <button t-att-class="state.filter === 'open' ? 'active' : ''" t-on-click="() => this.onFilter('open')">Open</button>
                                    <button t-att-class="state.filter === 'in_progress' ? 'active' : ''" t-on-click="() => this.onFilter('in_progress')">In Progress</button>
                                    <button t-att-class="state.filter === 'pending_verification' ? 'active' : ''" t-on-click="() => this.onFilter('pending_verification')">Pending Verification</button>
                                    <button t-att-class="state.filter === 'resolved' ? 'active' : ''" t-on-click="() => this.onFilter('resolved')">Resolved</button>
                                    <button t-att-class="state.filter === 'overdue' ? 'active' : ''" t-on-click="() => this.onFilter('overdue')">Overdue</button>
                                    <button t-att-class="state.filter === 'high' ? 'active' : ''" t-on-click="() => this.onFilter('high')">High / Critical</button>
                                </div>
                                <div class="o_ca_search">
                                    <i class="fa fa-search"/>
                                    <input type="text" placeholder="Search issues..." t-att-value="state.search" t-on-change="onSearch"/>
                                </div>
                                <select class="o_ca_select" t-att-value="state.severityFilter" t-on-change="onSeverityFilter">
                                    <option value="">All severities</option>
                                    <t t-foreach="severityOptions" t-as="opt" t-key="opt.value">
                                        <option t-att-value="opt.value" t-esc="opt.label"/>
                                    </t>
                                </select>
                            </div>

                            <div class="o_ca_card">
                                <div class="o_ca_card_head">Non-compliance issues</div>
                                <t t-if="state.records.length">
                                    <table class="o_ca_table">
                                        <thead>
                                            <tr>
                                                <th>Issue</th>
                                                <th>Severity</th>
                                                <th>Source</th>
                                                <th>Location</th>
                                                <th>Assignee</th>
                                                <th>Due</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                                <th/>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.records" t-as="rec" t-key="rec.id" t-on-click="() => this.setMode('detail', rec.id)">
                                                <td>
                                                    <div class="o_ca_row_title" t-esc="rec.name"/>
                                                    <div class="o_ca_row_sub">Ref: <t t-esc="rec.reference"/></div>
                                                </td>
                                                <td>
                                                    <span t-attf-class="o_ca_pill {{ ['high','critical'].includes(rec.severity) ? 'danger' : 'muted' }}" t-esc="severityLabel(rec.severity)"/>
                                                </td>
                                                <td t-esc="sourceLabel(rec.source)"/>
                                                <td t-esc="locationLabel(rec)"/>
                                                <td t-esc="m2oName(rec.assigned_user_id) or '—'"/>
                                                <td>
                                                    <div t-att-class="rec.is_overdue ? 'text-danger' : ''" t-esc="formatDate(rec.due_date)"/>
                                                </td>
                                                <td>
                                                    <CaStatusBadge state="displayState(rec)" label="displayStateLabel(rec)"/>
                                                </td>
                                                <td>
                                                    <span t-if="rec.action_count" class="o_ca_pill info" t-esc="rec.action_count"/>
                                                    <span t-else="">—</span>
                                                </td>
                                                <td>
                                                    <button class="o_ca_link" t-on-click.stop="() => this.setMode('detail', rec.id)">Open</button>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <div class="o_ca_pager">
                                        <span><t t-esc="pageFrom"/>–<t t-esc="pageTo"/> of <t t-esc="state.total"/></span>
                                        <div class="o_ca_pager_pages">
                                            <button t-att-disabled="state.page &lt;= 1" t-on-click="() => this.onPage(-1)">Prev</button>
                                            <button t-att-disabled="state.page &gt;= pageCount" t-on-click="() => this.onPage(1)">Next</button>
                                        </div>
                                    </div>
                                </t>
                                <CaEmptyState t-else="" title="'No issues match'" hint="emptyListHint"/>
                            </div>
                        </t>
                    </t>

                    <t t-if="state.mode === 'detail' and state.record">
                        <button class="o_ca_back" t-on-click="() => this.setMode('list')">
                            <i class="fa fa-arrow-left"/> Back to Non-Compliance
                        </button>
                        <div class="o_ca_page_header">
                            <div>
                                <h1 t-esc="state.record.name"/>
                                <p>
                                    <t t-esc="state.record.reference"/>
                                    · <t t-esc="severityLabel(state.record.severity)"/>
                                    · <t t-esc="sourceLabel(state.record.source)"/>
                                    · Due <t t-esc="formatDate(state.record.due_date)"/>
                                    · <CaStatusBadge state="displayState(state.record)" label="displayStateLabel(state.record)"/>
                                </p>
                            </div>
                            <div class="d-flex gap-2 flex-wrap" t-if="canManage">
                                <button t-if="state.record.state === 'open'" class="o_ca_btn primary" t-att-disabled="!!state.busy" t-on-click="() => this.runAction('action_assign')">Assign</button>
                                <button t-if="['open', 'assigned'].includes(state.record.state)" class="o_ca_btn primary" t-att-disabled="!!state.busy" t-on-click="() => this.runAction('action_start')">Start</button>
                                <button t-if="state.record.state === 'in_progress'" class="o_ca_btn" t-att-disabled="!!state.busy" t-on-click="() => this.runAction('action_submit_verification')">Submit for Verification</button>
                                <button t-if="state.record.state === 'pending_verification'" class="o_ca_btn primary" t-att-disabled="!!state.busy" t-on-click="() => this.runAction('action_resolve')">Resolve</button>
                                <button t-if="state.record.state === 'resolved'" class="o_ca_btn primary" t-att-disabled="!!state.busy" t-on-click="() => this.runAction('action_close')">Close</button>
                                <button t-if="detailEditable" class="o_ca_btn" t-att-disabled="!!state.busy" t-on-click="saveDetail">Save Details</button>
                                <button t-if="state.record.state !== 'closed'" class="o_ca_btn" t-att-disabled="!!state.busy" t-on-click="openAction">+ Corrective Action</button>
                            </div>
                        </div>

                        <div class="o_ca_detail_grid">
                            <div class="o_ca_form_section">
                                <h3>Issue details</h3>
                                <div class="o_ca_form_grid">
                                    <label>
                                        <span>Assignee</span>
                                        <select t-model="state.detailForm.assigned_user_id" t-att-disabled="!detailEditable">
                                            <option value="">Unassigned</option>
                                            <t t-foreach="state.lookups.users" t-as="u" t-key="u.id">
                                                <option t-att-value="u.id" t-esc="u.name"/>
                                            </t>
                                        </select>
                                    </label>
                                    <label>
                                        <span>Due date</span>
                                        <input type="date" t-model="state.detailForm.due_date" t-att-disabled="!detailEditable"/>
                                    </label>
                                    <label>
                                        <span>Requirement</span>
                                        <input type="text" t-att-value="m2oName(state.record.requirement_id) or '—'" disabled="1"/>
                                    </label>
                                    <label>
                                        <span>Location</span>
                                        <input type="text" t-att-value="locationLabel(state.record)" disabled="1"/>
                                    </label>
                                    <label class="o_ca_span_2">
                                        <span>Root cause</span>
                                        <textarea t-model="state.detailForm.root_cause" t-att-disabled="!detailEditable" rows="3"/>
                                    </label>
                                    <label class="o_ca_span_2">
                                        <span>Internal notes</span>
                                        <textarea t-model="state.detailForm.internal_notes" t-att-disabled="!detailEditable" rows="3"/>
                                    </label>
                                </div>
                                <p t-if="state.record.finding_id" class="o_ca_hint">
                                    Linked finding: <t t-esc="m2oName(state.record.finding_id)"/>
                                </p>
                            </div>

                            <div class="o_ca_form_section">
                                <h3>Corrective actions</h3>
                                <p t-if="!state.actions.length" class="o_ca_hint">No corrective actions yet.</p>
                                <div t-foreach="state.actions" t-as="act" t-key="act.id" class="o_ca_checklist_row">
                                    <div class="o_ca_row_title">
                                        <t t-esc="act.name"/>
                                        <CaStatusBadge state="actionDisplayState(act)" label="actionDisplayStateLabel(act)"/>
                                    </div>
                                    <div class="o_ca_row_sub">
                                        Due <t t-esc="formatDate(act.deadline)"/>
                                        · <t t-esc="m2oName(act.assigned_user_id) or 'Unassigned'"/>
                                    </div>
                                    <div class="o_ca_inline_form" t-if="canManage and act.state !== 'closed'">
                                        <input
                                            type="text"
                                            placeholder="Verification notes"
                                            t-att-value="state.actionNotes[act.id] || ''"
                                            t-on-change="(ev) => this.state.actionNotes[act.id] = ev.target.value"
                                        />
                                        <button class="o_ca_btn" t-att-disabled="!!state.busy" t-on-click="() => this.caSaveNotes(act.id)">Save notes</button>
                                    </div>
                                    <div class="d-flex gap-2 flex-wrap mt-2" t-if="canManage">
                                        <button t-if="act.state === 'open'" class="o_ca_btn primary" t-att-disabled="!!state.busy" t-on-click="() => this.caRun(act.id, 'action_start')">Start</button>
                                        <button t-if="act.state === 'in_progress'" class="o_ca_btn" t-att-disabled="!!state.busy" t-on-click="() => this.caRun(act.id, 'action_submit_verification')">Submit Verification</button>
                                        <button t-if="act.state === 'pending_verification'" class="o_ca_btn primary" t-att-disabled="!!state.busy" t-on-click="() => this.caRun(act.id, 'action_verify')">Verify</button>
                                        <button t-if="act.state === 'verified'" class="o_ca_btn primary" t-att-disabled="!!state.busy" t-on-click="() => this.caRun(act.id, 'action_close')">Close</button>
                                    </div>
                                    <div t-if="act.verified_by_id" class="o_ca_row_sub">
                                        Verified by <t t-esc="m2oName(act.verified_by_id)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <div t-if="state.showCreate" class="o_ca_modal_backdrop" t-on-click="closeCreate">
                        <div class="o_ca_modal" style="width: 720px; max-width: 100%;" t-on-click.stop="">
                            <div class="o_ca_modal_head">
                                <h2>Log Non-Compliance Issue</h2>
                                <button class="o_ca_modal_close" t-on-click="closeCreate"><i class="fa fa-times"/></button>
                            </div>
                            <div class="o_ca_modal_body">
                                <div class="o_ca_form_grid">
                                    <label class="o_ca_span_2">
                                        <span>Title *</span>
                                        <input type="text" t-model="state.form.name" placeholder="e.g., Blocked emergency exit"/>
                                    </label>
                                    <label>
                                        <span>Severity</span>
                                        <select t-model="state.form.severity">
                                            <t t-foreach="severityOptions" t-as="opt" t-key="opt.value">
                                                <option t-att-value="opt.value" t-esc="opt.label"/>
                                            </t>
                                        </select>
                                    </label>
                                    <label>
                                        <span>Due date</span>
                                        <input type="date" t-model="state.form.due_date"/>
                                    </label>
                                    <label>
                                        <span>Property</span>
                                        <select t-att-value="state.form.property_id" t-on-change="onPropertyChange">
                                            <option value="">Select property</option>
                                            <t t-foreach="state.lookups.properties" t-as="p" t-key="p.id">
                                                <option t-att-value="p.id" t-esc="p.name"/>
                                            </t>
                                        </select>
                                    </label>
                                    <label>
                                        <span>Building</span>
                                        <select t-att-value="state.form.building_id" t-on-change="onBuildingChange">
                                            <option value="">Optional</option>
                                            <t t-foreach="filteredBuildings" t-as="b" t-key="b.id">
                                                <option t-att-value="b.id" t-esc="b.name"/>
                                            </t>
                                        </select>
                                    </label>
                                    <label>
                                        <span>Area</span>
                                        <select t-model="state.form.area_id">
                                            <option value="">Optional</option>
                                            <t t-foreach="filteredAreas" t-as="a" t-key="a.id">
                                                <option t-att-value="a.id" t-esc="a.name"/>
                                            </t>
                                        </select>
                                    </label>
                                    <label>
                                        <span>Assignee</span>
                                        <select t-model="state.form.assigned_user_id">
                                            <option value="">Unassigned</option>
                                            <t t-foreach="state.lookups.users" t-as="u" t-key="u.id">
                                                <option t-att-value="u.id" t-esc="u.name"/>
                                            </t>
                                        </select>
                                    </label>
                                    <label class="o_ca_span_2">
                                        <span>Requirement</span>
                                        <select t-model="state.form.requirement_id">
                                            <option value="">Optional</option>
                                            <t t-foreach="state.lookups.requirements" t-as="r" t-key="r.id">
                                                <option t-att-value="r.id"><t t-esc="r.code"/> — <t t-esc="r.name"/></option>
                                            </t>
                                        </select>
                                    </label>
                                    <label class="o_ca_span_2">
                                        <span>Description</span>
                                        <textarea t-model="state.form.description" rows="3" placeholder="What is non-compliant?"/>
                                    </label>
                                    <label class="o_ca_span_2">
                                        <span>Root cause</span>
                                        <textarea t-model="state.form.root_cause" rows="2"/>
                                    </label>
                                </div>
                            </div>
                            <div class="o_ca_modal_foot">
                                <button class="o_ca_btn" t-on-click="closeCreate">Cancel</button>
                                <button class="o_ca_btn primary" t-att-disabled="!!state.busy" t-on-click="createIssue">
                                    <t t-esc="state.busy || 'Create Issue'"/>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div t-if="state.showAction" class="o_ca_modal_backdrop" t-on-click="closeAction">
                        <div class="o_ca_modal" style="width: 560px; max-width: 100%;" t-on-click.stop="">
                            <div class="o_ca_modal_head">
                                <h2>Add Corrective Action</h2>
                                <button class="o_ca_modal_close" t-on-click="closeAction"><i class="fa fa-times"/></button>
                            </div>
                            <div class="o_ca_modal_body">
                                <div class="o_ca_form_grid">
                                    <label class="o_ca_span_2">
                                        <span>Action title *</span>
                                        <input type="text" t-model="state.actionForm.name" placeholder="e.g., Clear exit path and retrain staff"/>
                                    </label>
                                    <label>
                                        <span>Deadline *</span>
                                        <input type="date" t-model="state.actionForm.deadline"/>
                                    </label>
                                    <label>
                                        <span>Assignee</span>
                                        <select t-model="state.actionForm.assigned_user_id">
                                            <option value="">Unassigned</option>
                                            <t t-foreach="state.lookups.users" t-as="u" t-key="u.id">
                                                <option t-att-value="u.id" t-esc="u.name"/>
                                            </t>
                                        </select>
                                    </label>
                                    <label class="o_ca_span_2">
                                        <span>Description</span>
                                        <textarea t-model="state.actionForm.description" rows="3"/>
                                    </label>
                                </div>
                            </div>
                            <div class="o_ca_modal_foot">
                                <button class="o_ca_btn" t-on-click="closeAction">Cancel</button>
                                <button class="o_ca_btn primary" t-att-disabled="!!state.busy" t-on-click="createCorrectiveAction">
                                    <t t-esc="state.busy || 'Add Action'"/>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </CaAppShell>
        </div>
    </t>
</templates>
